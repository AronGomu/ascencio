{
  "name": "ascencio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "legacy:assets:inventory": "node scripts/sync-asset-profiles.ts",
    "legacy:assets:profile-promote": "node scripts/promote-assets.ts",
    "legacy:assets:copy-migrate": "node scripts/migrate-assets.ts",
    "legacy:assets:copy-to-package-roots": "node scripts/restructure-assets.ts",
    "assets:bootstrap": "node scripts/download-mvp-assets.ts",
    "assets:engine:acquire": "node scripts/sync-engine.ts",
    "assets:engine:verify-acquired": "node scripts/verify-engine.ts",
    "assets:upstream:sync": "node scripts/sync-assets.ts",
    "assets:verify-all": "node scripts/verify-assets.ts && npm run assets:sets:verify-images && npm run assets:cards:verify-full",
    "assets:cards:download-full": "node scripts/download-images.ts",
    "assets:cards:download-cropped": "node scripts/download-images.ts --kind cropped",
    "assets:cards:download-cropped-reviewed-pool": "node scripts/download-images.ts --kind cropped --active",
    "assets:cards:verify-full": "node scripts/verify-images.ts",
    "assets:card-back:download": "node scripts/download-card-back.ts",
    "assets:sets:download-images": "node scripts/download-set-images.ts",
    "assets:sets:verify-images": "node scripts/verify-set-images.ts",
    "assets:images:pin": "node scripts/generate-image-lock.ts",
    "vendor:verify": "node scripts/verify-vendor.ts",
    "content:source-manifest:generate": "node scripts/generate-runtime-snapshot.ts",
    "content:source-manifest:verify": "node scripts/verify-runtime-snapshot.ts",
    "content:shop-sets:fetch-and-generate": "node scripts/generate-shop-sets.ts",
    "frontend:dev": "vite",
    "frontend:build": "npm run vendor:verify && npm run frontend:bundle && npm run frontend:verify",
    "frontend:bundle": "vite build --mode native",
    "frontend:verify": "node scripts/verify-native-build.ts",
    "frontend:verify-reproducible": "node scripts/verify-reproducible-build.ts",
    "frontend:preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"tests/**/*.{ts,svelte}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.html\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"tests/**/*.{ts,svelte}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.html\" \"*.{js,json,ts}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
    "test:tooling": "node --test tests/*.test.ts",
    "test:unit-and-performance": "vitest run tests/unit --exclude tests/unit/decks/deck-catalog-performance.test.ts && vitest run tests/unit/decks/deck-catalog-performance.test.ts",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:browser:native-bridge": "playwright test -c playwright.native.config.ts",
    "test:browser:visual-acceptance": "playwright test -c playwright.acceptance.config.ts",
    "test": "npm run test:tooling && npm run test:unit-and-performance && npm run test:component && npm run test:integration",
    "check:headless": "npm run format:check && npm run lint && npm run typecheck && npm run test:tooling && npm run test:unit-and-performance && npm run test:integration && npm run vendor:verify && npm run assets:verify-all && npm run content:source-manifest:verify",
    "check:frontend-and-browser": "npm run test:component && npm run frontend:build && npm run frontend:verify-reproducible && npm run test:browser:native-bridge && npm run test:browser:visual-acceptance",
    "check": "npm run check:headless && npm run check:frontend-and-browser",
    "content:convert:sqlite-to-json": "node scripts/readable-content.ts convert",
    "content:compile:json": "node scripts/readable-content.ts compile",
    "content:verify:sqlite-json-parity": "node scripts/verify-readable-parity.ts",
    "mods:bundle": "node scripts/package-mod.ts",
    "mods:audit:wasm-imports": "node scripts/audit-mod-runtime.ts",
    "legacy:content:export-sqlite": "node scripts/export-content-packages.ts",
    "legacy:content:verify-sqlite": "node scripts/verify-content-package.ts",
    "content:release:pin": "node scripts/readable-content-release.ts manifest",
    "content:stage:native": "node scripts/readable-content-release.ts prepare",
    "content:stage:verify-native": "node scripts/readable-content-release.ts verify-staged",
    "content:stage:cleanup": "node scripts/clean-native-content.ts",
    "native:desktop:dev": "tauri dev",
    "native:build-and-start:linux": "node scripts/start-desktop.ts",
    "native:desktop:build": "tauri build",
    "native:android:dev": "tauri android dev",
    "native:android:build": "tauri android build",
    "native:ios:dev": "tauri ios dev",
    "native:ios:build": "tauri ios build",
    "test:native:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "setup": "node scripts/setup-desktop.ts",
    "build": "tauri build --no-bundle",
    "start": "node scripts/start-desktop.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "^2.12.0",
    "svelte": "^5.56.4"
  }
}
