{
  "name": "ascencio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "assets:profiles:sync": "node scripts/sync-asset-profiles.ts",
    "assets:promote": "node scripts/promote-assets.ts",
    "assets:migrate": "node scripts/migrate-assets.ts",
    "assets:restructure": "node scripts/restructure-assets.ts",
    "assets:mvp": "node scripts/download-mvp-assets.ts",
    "assets:engine": "node scripts/sync-engine.ts",
    "assets:engine:verify": "node scripts/verify-engine.ts",
    "assets:sync": "node scripts/sync-assets.ts",
    "assets:sync:offline": "node scripts/sync-assets.ts --offline",
    "assets:verify": "node scripts/verify-assets.ts && npm run assets:sets:verify && npm run assets:images:verify",
    "assets:images": "node scripts/download-images.ts",
    "assets:images:cropped": "node scripts/download-images.ts --kind cropped",
    "assets:images:cropped:active": "node scripts/download-images.ts --kind cropped --active",
    "assets:images:verify": "node scripts/verify-images.ts",
    "assets:card-back": "node scripts/download-card-back.ts",
    "assets:sets": "node scripts/download-set-images.ts",
    "assets:sets:verify": "node scripts/verify-set-images.ts",
    "assets:lock": "node scripts/generate-image-lock.ts",
    "vendor:verify": "node scripts/verify-vendor.ts",
    "snapshot:generate": "node scripts/generate-runtime-snapshot.ts",
    "snapshot:verify": "node scripts/verify-runtime-snapshot.ts",
    "generate:shop-sets": "node scripts/generate-shop-sets.ts",
    "dev": "vite",
    "build": "npm run vendor:verify && npm run build:app && npm run build:verify",
    "build:app": "vite build --mode private",
    "build:native": "vite build --mode native",
    "build:verify": "node scripts/verify-browser-build.ts",
    "build:reproducible": "node scripts/verify-reproducible-build.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"tests/**/*.{ts,svelte}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"e2e-acceptance/**/*.ts\" \"e2e-core/**/*.ts\" \"*.html\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"tests/**/*.{ts,svelte}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"e2e-acceptance/**/*.ts\" \"e2e-core/**/*.ts\" \"*.html\" \"*.{js,json,ts}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test:legacy": "node --test tests/*.test.ts",
    "test:unit": "vitest run tests/unit --exclude tests/unit/decks/deck-catalog-performance.test.ts && vitest run tests/unit/decks/deck-catalog-performance.test.ts",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:core": "playwright test -c playwright.core.config.ts --project=chromium",
    "test:content:fixtures": "playwright test -c playwright.content-fixture.config.ts",
    "test:content:legacy": "node scripts/verify-content-browser-run.ts && playwright test -c playwright.content.config.ts && playwright test -c playwright.content-built.config.ts && playwright test -c playwright.t3.config.ts",
    "test:acceptance": "playwright test -c playwright.acceptance.config.ts",
    "test": "npm run test:legacy && npm run test:unit && npm run test:component && npm run test:integration",
    "check:headless": "npm run format:check && npm run lint && npm run typecheck && npm run test:legacy && npm run test:unit && npm run test:integration && npm run vendor:verify && npm run assets:verify && npm run snapshot:verify",
    "check:browser": "npm run test:component && npm run build && npm run build:reproducible && npm run test:e2e && npm run test:acceptance && npm run test:core && npm run test:content:fixtures",
    "check": "npm run check:headless && npm run check:browser",
    "content:export": "node scripts/export-content-packages.ts",
    "content:verify": "node scripts/verify-content-package.ts",
    "native:manifest": "node scripts/native-content-release.ts manifest",
    "native:prepare": "node scripts/native-content-release.ts prepare",
    "native:verify-staged": "node scripts/native-content-release.ts verify-staged",
    "native:clean-content": "node scripts/clean-native-content.ts",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "native:android:dev": "tauri android dev",
    "native:android:build": "tauri android build",
    "native:ios:dev": "tauri ios dev",
    "native:ios:build": "tauri ios build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10",
    "workbox-precaching": "7.4.1"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tauri-apps/api": "^2.12.0",
    "idb": "^8.0.3",
    "svelte": "^5.56.4"
  }
}
