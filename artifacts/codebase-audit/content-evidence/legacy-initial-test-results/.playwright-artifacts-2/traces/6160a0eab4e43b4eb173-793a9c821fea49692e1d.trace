{"type":"frame-snapshot","snapshot":{"callId":"call@32","snapshotName":"after@call@32","pageId":"page@6943b9e0d030ee130f6531d64ab4161e","frameId":"frame@cda3e4122e00d119ea35a4d2a3f72a7f","frameUrl":"http://127.0.0.1:4402/","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:4402/"}],"\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"description","content":"An offline preset Yu-Gi-Oh! duel powered by Project Ignis ocgcore."}],"\n    ",["TITLE",{},"YGO Story Duel Simulator"],"\n  ",["STYLE",{},"\n  .toast-region.svelte-2q11hz {\n    position: absolute;\n    z-index: 170;\n    top: var(--space-3);\n    right: var(--space-3);\n    display: grid;\n    width: min(24rem, calc(100% - var(--space-6)));\n    gap: var(--space-2);\n    pointer-events: none;\n  }\n\n  .toast.svelte-2q11hz {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: start;\n    gap: var(--space-2);\n    padding: var(--space-3);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    background: var(--surface-raised);\n    box-shadow: 0 0.5rem 1.5rem var(--shadow);\n    pointer-events: auto;\n    animation: svelte-2q11hz-toast-enter var(--motion-fast) ease-out;\n  }\n\n  .toast.success.svelte-2q11hz {\n    border-color: var(--success);\n  }\n\n  .toast.warning.svelte-2q11hz {\n    border-color: var(--warning);\n  }\n\n  .toast.error.svelte-2q11hz {\n    border-color: var(--danger);\n  }\n\n  p.svelte-2q11hz {\n    margin: 0;\n    line-height: 1.4;\n  }\n\n  button.svelte-2q11hz {\n    display: grid;\n    width: 2.75rem;\n    height: 2.75rem;\n    place-items: center;\n    padding: 0;\n    border: 0;\n    border-radius: var(--radius-sm);\n    color: var(--muted);\n    background: transparent;\n    cursor: pointer;\n  }\n\n  button.svelte-2q11hz:hover,\n  button.svelte-2q11hz:focus-visible {\n    color: var(--text);\n    background: var(--surface-chain);\n  }\n\n  svg.svelte-2q11hz {\n    width: 1rem;\n    height: 1rem;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2;\n    stroke-linecap: round;\n  }\n\n  @keyframes svelte-2q11hz-toast-enter {\n    from {\n      opacity: 0;\n      transform: translateY(-0.5rem);\n    }\n  }\n\n  @media (max-width: 40rem) {\n    .toast-region.svelte-2q11hz {\n      right: var(--space-2);\n      left: var(--space-2);\n      width: auto;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .toast.svelte-2q11hz {\n      animation: none;\n    }\n  }\n .svelte-2q11hz{}"],["STYLE",{},"\n  .domain-error.svelte-hqrovc {\n    display: grid;\n    align-content: center;\n    justify-items: center;\n    gap: var(--space-3);\n    width: 100%;\n    height: 100%;\n    padding: var(--space-6);\n    text-align: center;\n    /* The duel region is a two-row grid, so a region-filling child has to say\n       it spans both rows to centre in the stage rather than in the first. The\n       block-layout regions ignore this. */\n    grid-row: 1 / -1;\n  }\n\n  .actions.svelte-hqrovc {\n    display: flex;\n    align-items: center;\n    gap: var(--space-2);\n  }\n\n  /* `button.secondary` in `src/styles/app.css` is the app's quiet action, and\n     it is scoped to buttons; this link is the same action in anchor form. */\n  .actions.svelte-hqrovc a:where(.svelte-hqrovc) {\n    min-height: 2.75rem;\n    display: inline-flex;\n    align-items: center;\n    padding: 0.7rem 1rem;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    color: var(--text);\n    font-weight: 750;\n    text-decoration: none;\n  }\n\n  .domain-error.svelte-hqrovc p:where(.svelte-hqrovc) {\n    margin: 0;\n    color: var(--muted);\n  }\n .svelte-hqrovc{}"],["STYLE",{},"\n  h2.svelte-1psqgqf {\n    margin: 0;\n    font-size: var(--text-lg);\n  }\n\n  .hint.svelte-1psqgqf {\n    margin: 0;\n    color: var(--muted);\n    font-size: var(--text-sm);\n  }\n .svelte-1psqgqf{}"],["STYLE",{},"/* Integration-owned design tokens (T3).\n   Originally copied byte-for-byte from the pre-token `src/styles/app.css`\n   duel palette. `app.css` imports this file first and holds no raw colour\n   literals of its own, so the three UI domains (duel, deck editor, visual\n   novel) restyle onto one source of truth in T16.\n   2026-09-02: restyled to the owner-chosen \"Basilica Slate\" brand direction\n   (PRODUCT.md → Brand Commitments): gold ceremonial accent, warm-white text,\n   serif type, angular radii, translucent glass panel primitives. The slate\n   surface family already matched and is unchanged. */\n:root {\n  /* surface */\n  --bg: #08101f;\n  --bg-deep: #040912;\n  --bg-deeper: #040d16;\n  --surface: #111b2f;\n  --surface-raised: #18243b;\n  --surface-strong: var(--surface-raised);\n  --surface-highlight: #22324e;\n  --surface-sunken: #0b1424;\n  --surface-inset: #0c1728;\n  --surface-panel: #101a2d;\n  --surface-deep: #08111f;\n  --surface-field-top: #0b1728;\n  --surface-chain: #0d1729;\n  --border: #697895;\n  --border-strong: #486078;\n  --border-soft: #53627e;\n  --border-light: #8ba0bf;\n  --scrollbar-track: var(--surface-sunken);\n  --scrollbar-thumb: #73829d;\n  --scrollbar-thumb-hover: var(--border-light);\n  --scrollbar-thumb-active: var(--accent-strong);\n  --scrollbar-border: var(--border);\n\n  /* text */\n  --text: #eef1f7;\n  --muted: #a9b5ca;\n  --ink: #ffffff;\n  --ink-on-accent: #14100a;\n  --ink-on-danger: #24060b;\n  --ink-on-warning: #2b1d00;\n  --ink-on-legal: #06170d;\n  --text-accent-soft: #f7eed8;\n\n  /* brand + state */\n  --accent: #d3b268;\n  --accent-strong: #c19a45;\n  --accent-deep: #8a6f33;\n  /* Basilica Slate glass + chamfer primitives: translucent blue-tinted\n     panels over the dark ground, hairline gold for ceremonial edges. */\n  --glass: rgba(150, 175, 215, 0.02);\n  --glass-strong: rgba(150, 175, 215, 0.036);\n  --line-soft: rgba(170, 190, 220, 0.18);\n  --gold-line: rgba(211, 178, 104, 0.6);\n  --chamfer: 6px;\n  --legal: #7ee2a8;\n  --success: var(--legal);\n  --selected: #ffd580;\n  --warning: var(--selected);\n  --selected-strong: #ffc75c;\n  --danger: #ff8c9b;\n  --phase-player: #2b5f9e;\n  --danger-strong: #ff455d;\n  --danger-border: #a43b50;\n  --danger-surface: #321825;\n  --danger-deep: #561b2a;\n  --warning-border: #896b28;\n  --warning-surface: #2e2819;\n  --neutral: #33405a;\n  --neutral-hover: #3f4e6c;\n  --focus-ring: #f6c177;\n  --shadow: #000000;\n\n  /* rarity halo primitives */\n  --rarity-halo-rare: #c0c8d8;\n  --rarity-halo-super-rare: #4ea3ff;\n  --rarity-halo-ultra-rare: #ffcf4d;\n  --rarity-halo-secret-rare: #d06bff;\n  --rarity-halo-ultimate-rare: #b8722d;\n  --rarity-halo-ghost-rare: #eaf6ff;\n\n  /* duel field palette */\n  --field-glow: #1e3a5f;\n  --field-border: #436558;\n  --field-surface: #153d35;\n  --field-gradient-from: #173f36;\n  --field-gradient-to: #102e2a;\n  --field-hud-border: #4e8b72;\n  --field-hud-glow: #1f5b46;\n  --field-sheen: #d5f0e6;\n  --field-zone-outline: #b7dccf;\n  --field-zone-fill: #081a19;\n  --field-zone-shared: #134542;\n  --field-card-edge: #ebf3ff;\n  --stack-accent: #9f8deb;\n  --stack-surface: #201d35;\n\n  /* scale */\n  --space-1: 0.25rem;\n  --space-2: 0.5rem;\n  --space-3: 0.75rem;\n  --space-4: 1rem;\n  --space-5: 1.5rem;\n  --space-6: 2rem;\n  --radius-sm: 0.15rem;\n  --radius-md: 0.25rem;\n  --radius-lg: 0.4rem;\n  --font-ui: \"Source Serif 4\", Georgia, ui-serif, serif;\n  --font-display: \"Forum\", \"Source Serif 4\", Georgia, serif;\n  --ls-display: 0.16em;\n  --text-xs: 0.72rem;\n  --text-sm: 0.85rem;\n  --text-md: 1rem;\n  --text-lg: 1.25rem;\n  --motion-fast: 120ms;\n  --motion-base: 200ms;\n\n  /* layers — moved verbatim from app.css */\n  --duel-field-layer-surface: 0;\n  --duel-field-layer-zone: 10;\n  --duel-field-layer-stack: 20;\n  --duel-field-layer-card: 30;\n  --duel-field-layer-card-raised: 35;\n  --duel-field-layer-label: 40;\n  --duel-field-layer-control: 50;\n  --duel-field-layer-menu: 100;\n  /* Floating field windows sit above menus and below the drag ghost, which\n     is meant to fly over them (T13). The raised layer is ephemeral: the last\n     window the player pressed takes it (ADR-017). */\n  --duel-field-layer-window: 110;\n  --duel-field-layer-window-active: 120;\n  --duel-field-layer-hand-zoom: 140;\n  --duel-field-layer-drag-ghost: 150;\n  /* Item 6: the drop confirmation is the one field surface that outranks the\n     ghost — the card springs home behind it while the question is still\n     unanswered, and the question must never be the thing that is covered. */\n  --duel-field-layer-drop-confirm: 160;\n\n  /* deck-select seat halos */\n  --seat-you: #4ea3ff;\n  --seat-opponent: var(--danger);\n}\n/* Basilica Slate brand faces (PRODUCT.md → Brand Commitments), bundled into\n   core application CSS because product is offline: no network fetch may stand\n   between player and type. Latin subsets only; both Source\n   Serif 4 files are variable (wght 400–700), Forum ships its single 400.\n   Source: Google Fonts, SIL Open Font License. */\n@font-face {\n  font-family: \"Forum\";\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"/src/assets/fonts/forum-latin.woff2\") format(\"woff2\");\n}\n\n@font-face {\n  font-family: \"Source Serif 4\";\n  font-style: normal;\n  font-weight: 400 700;\n  font-display: swap;\n  src: url(\"/src/assets/fonts/source-serif-4-latin.woff2\") format(\"woff2\");\n}\n\n@font-face {\n  font-family: \"Source Serif 4\";\n  font-style: italic;\n  font-weight: 400 700;\n  font-display: swap;\n  src: url(\"/src/assets/fonts/source-serif-4-italic-latin.woff2\") format(\"woff2\");\n}\n/* Shared UI primitives (T16). Imported by app.css after tokens.css.\n   Every rule here uses only var() references — no raw colour literals.\n   Components opt in via class names; per-domain overrides may add modifiers. */\n\n.ui-button {\n  min-height: 2.75rem;\n  padding: 0.7rem 1rem;\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  font-family: var(--font-ui);\n  font-weight: 750;\n  cursor: pointer;\n}\n\n.ui-button--primary {\n  color: var(--ink-on-accent);\n  background: var(--accent);\n}\n\n.ui-button--primary:hover:not(:disabled) {\n  background: var(--accent-strong);\n}\n\n.ui-button--secondary {\n  color: var(--text);\n  background: transparent;\n  border-color: var(--border);\n}\n\n.ui-button--danger {\n  color: var(--ink-on-danger);\n  background: var(--danger);\n}\n\n.ui-button:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.ui-panel {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n}\n\n.ui-overlay {\n  background: color-mix(in srgb, var(--bg) 82%, transparent);\n}\n\n.ui-field {\n  background: var(--surface-raised);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n}\n\n.ui-focusable:focus-visible {\n  outline: 3px solid var(--focus-ring);\n  outline-offset: 3px;\n}\n\n.ui-chamfer {\n  border-radius: 0;\n  clip-path: polygon(\n    var(--chamfer) 0,\n    100% 0,\n    100% calc(100% - var(--chamfer)),\n    calc(100% - var(--chamfer)) 100%,\n    0 100%,\n    0 var(--chamfer)\n  );\n}\n\n.ui-glass-panel {\n  background: var(--glass-strong);\n  border: 1px solid var(--gold-line);\n}\n\n.ui-dialog-panel {\n  background: var(--surface-panel);\n  border: 1px solid var(--gold-line);\n  box-shadow: none;\n}\n\n.ui-dialog-title {\n  font-family: var(--font-display);\n  font-weight: 400;\n  letter-spacing: var(--ls-display);\n  text-transform: uppercase;\n  text-align: center;\n  color: var(--accent);\n}\n\n.ui-dialog-title::after {\n  content: \"\";\n  display: block;\n  width: 3.5rem;\n  height: 1px;\n  background: var(--gold-line);\n  margin: 0.5rem auto 0;\n}\n\n:root {\n  font-family: var(--font-ui);\n  color: var(--text);\n  background: var(--bg);\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  --preview-w: 15.5rem;\n  --rail-min: 11rem;\n  /* The phase bar spans the board's own column above it, so it is the one\n     shell pane that costs the board height instead of width. Tall enough for\n     the chips' 44px pointer-target floor plus the bar's own border. */\n  --phase-bar-h: 3rem;\n  /* How much of the reclaimed pillarbox the board is allowed to spend on\n     breathing room before the rail takes the rest. Never comes out of the\n     board's own width — see `.duel-field-slot`. */\n  --duel-field-inset: 1.5rem;\n}\n\n* {\n  box-sizing: border-box;\n  scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);\n  scrollbar-width: thin;\n}\n\n*::-webkit-scrollbar {\n  width: 0.75rem;\n  height: 0.75rem;\n}\n\n*::-webkit-scrollbar-track {\n  border: 1px solid var(--scrollbar-border);\n  background: var(--scrollbar-track);\n}\n\n*::-webkit-scrollbar-thumb {\n  border: 2px solid var(--scrollbar-border);\n  border-radius: 999px;\n  background: var(--scrollbar-thumb);\n}\n\n*::-webkit-scrollbar-thumb:hover {\n  background: var(--scrollbar-thumb-hover);\n}\n\n*::-webkit-scrollbar-thumb:active {\n  background: var(--scrollbar-thumb-active);\n}\n\n@media (forced-colors: active) {\n  * {\n    scrollbar-color: auto;\n    scrollbar-width: auto;\n  }\n\n  *::-webkit-scrollbar-track {\n    border-color: Canvas;\n    background: Canvas;\n  }\n\n  *::-webkit-scrollbar-thumb {\n    border-color: Canvas;\n    background: CanvasText;\n  }\n}\n\nbody {\n  min-width: 320px;\n  min-height: 100svh;\n  margin: 0;\n  /* The stage — never the page — owns every axis of overflow, so no mode can\n     put a scrollbar on `body`. */\n  overflow: hidden;\n  background:\n    radial-gradient(circle at 15% -10%, var(--field-glow) 0, transparent 35rem),\n    var(--bg);\n}\n\n/* The app root fills the viewport and centres the stage inside it; the\n   leftover space on either axis is the `--bg` letterbox bar. */\n#app {\n  height: 100svh;\n  display: grid;\n  place-items: center;\n  background: var(--bg);\n}\n\n/* T4: one layout law for the whole product. Above 1024px the app is a\n   centred 16:9 rectangle; below it a portrait viewport fills instead. Domains\n   measure `--stage-h`/`--stage-w` rather than the viewport, so the duel keeps\n   its `100svh`-equivalent behavior relative to the stage. The fallbacks keep\n   every rule below correct in surfaces that mount a domain without the shell\n   (the acceptance harness), where the stage box is simply the viewport.\n\n   The box is derived here rather than published from `AppShell`, so it is\n   recomputed by the same layout pass that applies a viewport change: anything\n   measuring straight after a resize reads the new stage, never the previous\n   one. `AppShell` still publishes the equivalent box on `STAGE_CONTEXT_KEY`\n   and the mode on `data-stage-mode`; `selectStageMode` and the query below\n   encode the same rule (`STAGE_BREAKPOINT_PX`) and must stay in sync. */\n.app-stage {\n  --stage-viewport-w: calc(100vw - var(--space-2) * 2);\n  --stage-viewport-h: calc(100svh - var(--space-2) * 2);\n  --stage-w: min(\n    var(--stage-viewport-w),\n    calc(var(--stage-viewport-h) * 16 / 9)\n  );\n  --stage-h: min(\n    var(--stage-viewport-h),\n    calc(var(--stage-viewport-w) * 9 / 16)\n  );\n\n  position: relative;\n  width: var(--stage-w);\n  height: var(--stage-h);\n  margin: var(--space-2);\n  overflow: hidden;\n}\n\n/* `mobile-portrait`: below the breakpoint a viewport at least as tall as it is\n   wide drops the letterbox and takes the whole viewport. */\n@media (max-width: 1023.98px) and (orientation: portrait) {\n  .app-stage {\n    --stage-w: var(--stage-viewport-w);\n    --stage-h: var(--stage-viewport-h);\n  }\n}\n\n/* The duel is the one region that spends the pillarbox. Above 16:9 — which is\n   what a 1920x1080 screen becomes as soon as browser chrome eats into the\n   height — T4 leaves a `--bg` bar on each side. The board cannot use them: it\n   is sized from `--stage-h` (see `.duel-field-slot`), so a wider column buys\n   no bigger board, only more dead space around it. So the width law is lifted\n   for the duel and the height law is left exactly as it was: the board is\n   unchanged, keeps `--duel-field-inset` of the reclaimed space as margin, and\n   the right rail's `1fr` absorbs everything else.\n\n   Only above the breakpoint. Below it the three-column shell is already tight\n   and the portrait duel runs on its own rotated box, so neither mode has bars\n   worth handing to a rail.\n\n   `computeStageBox` deliberately still reports the 16:9 box: it is read by the\n   deck editor, which never renders on this route. */\n@media (min-width: 1024px) {\n  .app-stage[data-stage-route=\"free-play\"],\n  .app-stage[data-stage-route=\"duel-session\"] {\n    --stage-w: var(--stage-viewport-w);\n    --duel-field-margin: clamp(\n      0px,\n      calc((var(--stage-viewport-w) - var(--stage-h) * 16 / 9) / 2),\n      var(--duel-field-inset)\n    );\n  }\n}\n\n.shell-region--duel {\n  height: var(--stage-h, 100svh);\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n/* T15: a phone held vertically plays the duel a quarter turn clockwise rather\n   than on a 16:9 board squeezed into a tall viewport. Landscape below the\n   breakpoint keeps the scaled stage, which is why this query carries\n   `orientation: portrait` on top of the same 1023.98px edge `.app-stage` uses\n   (and `selectStageMode` mirrors as `STAGE_BREAKPOINT_PX` / `height >= width`).\n\n   Only the duel region rotates — not `.app-stage` — because the stage is shared\n   with the deck editor, the story and the home hub, all of which read upright\n   in portrait already (T14). Redeclaring `--stage-w`/`--stage-h` here is what\n   re-points every descendant that sizes itself against the stage box\n   (`main.is-duel-viewport`, `.duel-shell`, `.duel-field-slot`) at the rotated\n   box, so the field geometry is derived from the long axis of the screen.\n\n   The box is still derived in CSS rather than published from `AppShell`, for\n   the same reason `.app-stage` is: a JS-published box trails a viewport change\n   by at least a frame. `AppShell` only mirrors the flag on `data-stage-rotated`.\n\n   `position: absolute` + a centred quarter turn (rather than\n   `transform-origin: top left` plus a pixel translation) keeps the rotated box\n   centred with no measured number anywhere. It also makes this element the\n   containing block for the duel's `fixed` children — dialog backdrops, card\n   trays, the drag ghost — so they rotate with the board instead of escaping to\n   the viewport; shared stage geometry maps the viewport\n   coordinates those children are driven by into this frame. */\n@media (max-width: 1023.98px) and (orientation: portrait) {\n  .shell-region--duel {\n    --stage-w: min(100svh, calc(100vw * 16 / 9));\n    --stage-h: min(100vw, calc(100svh * 9 / 16));\n    /* Portrait's local long axis is only the rotated 16:9 stage width. Keep\n       every shell pane, but compact their existing seams so the field retains\n       enough width for geometry-sized targets instead of shrinking cards. */\n    --preview-w: 8rem;\n    --rail-min: 7rem;\n\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: var(--stage-w);\n    transform: translate(-50%, -50%) rotate(90deg);\n\n    /* The duel itself is pinned to `--stage-h` and never overflows, so this\n       scroller stays inert during play (`main.is-duel-viewport` and\n       `.duel-shell` are both exactly the stage's height). It exists for the\n       screen *before* the duel: the deck picker is a document-shaped page, and\n       a turned stage is only ~390px along this axis on a phone, so without it\n       the Start button is clipped out of reach. Same treatment the deck editor\n       region already gets — the scroll belongs to the region, never the page. */\n    overflow: auto;\n  }\n}\n\n.shell-region--home,\n.shell-region--install-content {\n  width: 100%;\n  height: 100%;\n  overflow: auto;\n}\n\n/* Free play opens on its match setup, which asks for nothing the home region\n   does not. The route it shares with the duel widens the stage above the\n   breakpoint; the setup is start-aligned inside it either way. */\n.shell-region--free-play {\n  width: 100%;\n  height: 100%;\n}\n\n/* The app's front door, styled like the visual novel's own title screen\n   (ADR-051). The treatment lives here rather than in the component's scoped\n   styles because the shell's menu and the story's in-playthrough title are two\n   authorings of one look, and only the shell's half is allowed to be eager —\n   so neither can reach for the other's stylesheet. */\n.main-menu {\n  display: grid;\n  align-content: center;\n  justify-items: center;\n  gap: var(--space-2);\n  width: 100%;\n  height: 100%;\n  padding: clamp(var(--space-4), 8vw, var(--space-6));\n  overflow: auto;\n  text-align: center;\n  background:\n    radial-gradient(\n      55% 75% at 50% -12%,\n      color-mix(in srgb, var(--accent) 16%, transparent),\n      transparent 60%\n    ),\n    radial-gradient(\n      45% 60% at 85% 90%,\n      color-mix(in srgb, var(--phase-player) 30%, transparent),\n      transparent 70%\n    ),\n    linear-gradient(\n      180deg,\n      var(--surface-deep),\n      var(--bg) 60%,\n      var(--bg-deeper)\n    );\n}\n\n.main-menu__eyebrow {\n  margin: 0;\n  color: var(--muted);\n  font-size: var(--text-xs);\n  letter-spacing: 0.14em;\n}\n\n.main-menu__title {\n  margin: 0;\n  font-family: var(--font-display);\n  font-weight: 400;\n  font-size: clamp(2.6rem, 8vw, 4.5rem);\n  line-height: 1;\n  letter-spacing: 0.26em;\n  text-indent: 0.26em;\n  text-shadow: 0 1px 26px color-mix(in srgb, var(--accent) 30%, transparent);\n}\n\n.main-menu__title b {\n  font-weight: 400;\n  color: var(--accent);\n}\n\n.main-menu__tagline {\n  margin: 0;\n  color: var(--muted);\n  font-style: italic;\n}\n\n.main-menu__entries {\n  display: grid;\n  gap: var(--space-3);\n  width: min(20rem, 100%);\n  margin-block-start: var(--space-5);\n}\n\n.main-menu__entries button {\n  padding-block: var(--space-3);\n  font-family: var(--font-display);\n  font-size: var(--text-md);\n  font-weight: 400;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--accent);\n  background:\n    linear-gradient(\n      180deg,\n      color-mix(in srgb, var(--accent) 10%, transparent),\n      color-mix(in srgb, var(--accent) 3%, transparent)\n    ),\n    var(--glass);\n  border: 1px solid var(--gold-line);\n  border-radius: 0;\n  clip-path: polygon(\n    var(--chamfer) 0,\n    100% 0,\n    100% calc(100% - var(--chamfer)),\n    calc(100% - var(--chamfer)) 100%,\n    0 100%,\n    0 var(--chamfer)\n  );\n  transition:\n    background var(--motion-fast) ease-out,\n    border-color var(--motion-fast) ease-out;\n}\n\n.main-menu__entries button:hover:not(:disabled) {\n  background:\n    linear-gradient(\n      180deg,\n      color-mix(in srgb, var(--accent) 18%, transparent),\n      color-mix(in srgb, var(--accent) 6%, transparent)\n    ),\n    var(--glass-strong);\n}\n\n.main-menu__entries button.secondary {\n  color: var(--text);\n  background: var(--glass);\n  border-color: var(--line-soft);\n}\n\n.main-menu__entries button.secondary:hover:not(:disabled) {\n  background: var(--glass-strong);\n  border-color: var(--gold-line);\n}\n\n.main-menu__hint {\n  margin-block: var(--space-4) 0;\n  color: var(--muted);\n  font-size: var(--text-sm);\n}\n\n/* Desktop deck panes own their necessary overflow. The shell region stays a\n   fixed stage track, so editor content cannot create a second scrollbar. */\n.shell-region--decks {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  overflow: hidden;\n}\n\n/* Portrait panes remain document-shaped: their filled workspace/catalog lets\n   this region scroll so every tab stays reachable without moving the page. */\n@media (max-width: 1023.98px) {\n  .shell-region--decks {\n    overflow: auto;\n  }\n}\n\n/* The collection is a long grid of tiles, so it scrolls inside the stage on the\n   same terms as the deck editor. */\n.shell-region--collection {\n  width: 100%;\n  height: 100%;\n  overflow: auto;\n}\n\n/* The developer console is a long list of controls, so it scrolls inside the\n   stage on the same terms as the deck editor. */\n.shell-region--admin {\n  width: 100%;\n  height: 100%;\n  overflow: auto;\n}\n\n/* The story pins its pause control and overlay backdrops with `position:\n   fixed`, which resolves against the viewport and would escape the letterbox\n   into the stage's bars. `contain: layout` makes this region their containing\n   block, so they stay inside the stage without the domain having to know the\n   shell exists. */\n.shell-region--story {\n  width: 100%;\n  height: 100%;\n  overflow: auto;\n  contain: layout;\n}\n\nbutton,\ninput,\nselect {\n  font: inherit;\n}\n\nbutton {\n  min-height: 2.75rem;\n  padding: 0.7rem 1rem;\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  color: var(--ink-on-accent);\n  background: var(--accent);\n  font-weight: 750;\n  cursor: pointer;\n}\n\nbutton:hover:not(:disabled) {\n  background: var(--accent-strong);\n}\n\nbutton.secondary {\n  color: var(--text);\n  border-color: var(--border);\n  background: transparent;\n}\n\nbutton.danger {\n  color: var(--ink-on-danger);\n  background: var(--danger);\n}\n\nbutton.warning {\n  color: var(--ink-on-warning);\n  border-color: transparent;\n  background: var(--warning);\n}\n\nbutton.warning:hover:not(:disabled) {\n  background: var(--selected-strong);\n}\n\nbutton.neutral {\n  color: var(--text);\n  border-color: var(--border);\n  background: var(--neutral);\n}\n\nbutton.neutral:hover:not(:disabled) {\n  background: var(--neutral-hover);\n}\n\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n:focus-visible {\n  outline: 3px solid var(--focus-ring);\n  outline-offset: 3px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.loading-overlay {\n  position: fixed;\n  z-index: var(--duel-field-layer-menu);\n  top: 0;\n  left: 50%;\n  display: grid;\n  gap: 0.25rem;\n  width: min(24rem, calc(100% - 1rem));\n  padding: 0.5rem 0.75rem;\n  border: 1px solid var(--border);\n  border-top: 0;\n  border-radius: 0 0 var(--radius-md) var(--radius-md);\n  background: color-mix(in srgb, var(--surface) 94%, transparent);\n  transform: translateX(-50%);\n}\n\n.loading-overlay p {\n  margin: 0;\n  color: var(--accent);\n  font-family: var(--font-display);\n  font-size: 0.78rem;\n  font-weight: 400;\n  letter-spacing: var(--ls-display);\n  text-align: center;\n  text-transform: uppercase;\n}\n\nmain {\n  width: min(120rem, calc(100% - 2rem));\n  margin-inline: auto;\n  display: grid;\n  gap: 1rem;\n  padding-bottom: 3rem;\n}\n\n/* Applied only while a board/snapshot renders and neither optional HUD nor\n   workspace is shown (see `duelViewportOnly` in App.svelte). It pins the\n   default duel to the `#app` main row's exact height, so nothing here can\n   push a scrollbar onto the page; `.duel-field` owns any residual x/y\n   overflow instead (see below). */\nmain.is-duel-viewport {\n  width: 100%;\n  height: var(--stage-h, 100svh);\n  min-height: 0;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n}\n\n.dialog-backdrop {\n  position: fixed;\n  z-index: var(--duel-field-layer-menu);\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 1rem;\n  background: color-mix(in srgb, var(--bg-deep) 72%, transparent);\n  backdrop-filter: blur(12px);\n}\n\n.dialog-panel {\n  display: grid;\n  gap: 0.75rem;\n  width: min(28rem, 100%);\n  max-height: 85svh;\n  overflow: auto;\n  padding: 1.15rem;\n  border: 1px solid var(--gold-line);\n  border-radius: 0;\n  background: var(--surface-panel);\n  box-shadow: none;\n  clip-path: polygon(\n    var(--chamfer) 0,\n    100% 0,\n    100% calc(100% - var(--chamfer)),\n    calc(100% - var(--chamfer)) 100%,\n    0 100%,\n    0 var(--chamfer)\n  );\n}\n\n@media (max-width: 1023.98px) and (orientation: portrait) {\n  /* Portaled duel dialogs leave the transformed shell so Chromium paint and\n     hit-test geometry agree, then rotate explicitly with the duel. */\n  body > [data-duel-dialog-portal] {\n    inset: auto;\n    top: 50%;\n    left: 50%;\n    width: 100svh;\n    height: 100vw;\n    transform: translate(-50%, -50%) rotate(90deg);\n    backdrop-filter: none;\n  }\n\n  body > [data-duel-dialog-portal] > .dialog-panel {\n    max-height: 85vw;\n  }\n}\n\nh1,\nh2,\nh3,\nh4,\np {\n  margin-top: 0;\n}\n\nh1 {\n  margin-bottom: 0;\n  font-size: clamp(1.75rem, 5vw, 3.25rem);\n  letter-spacing: -0.045em;\n}\n\nh2,\nh3,\nh4 {\n  margin-bottom: 0.55rem;\n}\n\n.eyebrow {\n  margin-bottom: 0.35rem;\n  color: var(--accent);\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.engine-state,\n.phase-pill,\n.event-log span {\n  margin: 0;\n  padding: 0.35rem 0.65rem;\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  color: var(--muted);\n  white-space: nowrap;\n}\n\n.duel-shell {\n  width: 100%;\n  height: var(--stage-h, 100svh);\n  margin: 0;\n  display: grid;\n  grid-template-columns: var(--preview-w) auto minmax(var(--rail-min), 1fr);\n  grid-template-rows: minmax(0, 1fr);\n  align-items: stretch;\n  padding: 0;\n  overflow: hidden;\n}\n\n.card-preview-panel {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  gap: 0.75rem;\n  min-width: 0;\n  min-height: 0;\n  padding: 1rem;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background: color-mix(in srgb, var(--surface) 94%, transparent);\n}\n\n.card-preview-panel__art img {\n  display: block;\n  width: 100%;\n  max-height: min(22rem, calc(var(--stage-h, 100svh) * 0.48));\n  object-fit: contain;\n  border-radius: 0.5rem;\n}\n\n/* A column rather than a row template: the stats row is optional, so any\n   fixed template hands the free space to whichever child happens to land in\n   the flexible track. The text region claims it explicitly instead, and the\n   single `gap` is the only separation name, stats and effect text ever get. */\n.card-preview-panel__body {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  min-height: 0;\n}\n\n/* The name is a heading, so it arrives with the global `h2` bottom margin —\n   and a flex gap does not collapse with a margin, it adds to it. Cancelled\n   here rather than on the global rule, which every other heading in the app\n   still wants: the effect text then sits under the stats at the same step the\n   stats sit under the name. */\n.card-preview-panel__body h2 {\n  margin-bottom: 0;\n}\n\n.card-preview-panel__stats {\n  margin: 0;\n  color: var(--muted);\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n\n.card-preview-panel__text-region {\n  position: relative;\n  min-height: 0;\n  flex: 1 1 auto;\n}\n\n.card-preview-panel__text {\n  height: 100%;\n  min-height: 0;\n  overflow-y: auto;\n  padding-inline-end: 10px;\n  color: var(--muted);\n  scrollbar-width: none;\n  white-space: pre-wrap;\n  text-align: left;\n}\n\n.card-preview-panel__text::-webkit-scrollbar {\n  display: none;\n}\n\n.duel-right-rail {\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr) auto;\n  gap: 0.75rem;\n  min-width: 0;\n  border-inline-start: 1px solid var(--border);\n  /* Without this the header and the prompt copy start one pixel from the new\n     divider and read as if they were leaning on it. */\n  padding-inline-start: 0.5rem;\n  /* The pillarbox used to sit between this rail and the edge of the screen.\n     Once the duel spends it the rail runs to the true viewport edge, so it\n     keeps the same inset the board does — and only while there was a bar to\n     spend, so an exactly-16:9 viewport is untouched. */\n  padding-inline-end: var(--duel-field-margin, 0px);\n}\n.duel-right-rail__header {\n  border-bottom: 2px solid var(--border);\n  padding-bottom: 0.5rem;\n  margin-bottom: 0.25rem;\n}\n.duel-right-rail__top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem;\n}\n.duel-right-rail__top strong {\n  font-size: 0.95rem;\n  font-weight: 800;\n}\n.duel-right-rail__options {\n  width: 2.5rem;\n  height: 2.5rem;\n  padding: 0;\n  flex: 0 0 2.5rem;\n}\n.duel-right-rail__identity {\n  display: grid;\n  justify-items: center;\n}\n/* The avatar is square and sized by the column, so on its own it would grow\n   with the rail — and the rail now grows with whatever the duel reclaims from\n   the pillarbox. Two of them plus the status band have to fit the stage's\n   height, so the square is capped at 0.32 of `--stage-h` and the surplus width\n   goes to the status text instead. The cap only bites once the rail is wider\n   than that fraction of the stage is tall; at `--rail-min` the column still\n   wins, which is also what keeps a short viewport's rail intact. */\n.duel-right-rail__identity img,\n.duel-right-rail__life {\n  width: min(100%, calc(var(--stage-h, 100svh) * 0.32));\n}\n.duel-right-rail__identity img {\n  display: block;\n  height: auto;\n  aspect-ratio: 1;\n  object-fit: cover;\n  border: 4px solid var(--border);\n  border-radius: var(--radius-sm);\n}\n.duel-right-rail__identity img.active {\n  border-color: var(--selected);\n}\n.duel-right-rail__life {\n  display: block;\n  margin: 0.35rem auto 0;\n  padding: 0.3rem 0;\n  border: 2px solid var(--border);\n  border-radius: var(--radius-sm);\n  background: color-mix(in srgb, var(--bg-deep) 70%, transparent);\n  font-size: 1.35rem;\n  font-weight: 800;\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n}\n.duel-right-rail__life.active {\n  border-color: var(--selected);\n}\n.duel-right-rail__life.is-high {\n  color: var(--success);\n}\n.duel-right-rail__life.is-mid {\n  color: var(--warning);\n}\n.duel-right-rail__life.is-low {\n  color: var(--danger);\n}\n.duel-right-rail__status {\n  flex: 1;\n  display: grid;\n  place-content: center;\n  text-align: center;\n  min-width: 0;\n}\n.duel-right-rail__status h2 {\n  font-size: clamp(1.05rem, 2vw, 1.6rem);\n  text-wrap: balance;\n}\n.duel-right-rail__status p {\n  color: var(--muted);\n}\n.duel-right-rail__dots {\n  display: inline-flex;\n  gap: 0.15rem;\n}\n.duel-right-rail__dots i {\n  width: 0.28rem;\n  height: 0.28rem;\n  border-radius: 999px;\n  background: currentcolor;\n  opacity: 1;\n  animation: duel-rail-dot 1.2s infinite ease-in-out;\n}\n.duel-right-rail__dots i:nth-child(2) {\n  animation-delay: 0.2s;\n}\n.duel-right-rail__dots i:nth-child(3) {\n  animation-delay: 0.4s;\n}\n\n@keyframes duel-rail-dot {\n  0%,\n  80%,\n  100% {\n    opacity: 0.15;\n  }\n  40% {\n    opacity: 1;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .duel-right-rail__dots i {\n    animation-name: none !important;\n    animation-duration: 0s !important;\n    opacity: 1 !important;\n  }\n}\n\n@media (max-width: 1500px) {\n  :root {\n    --preview-w: 13.5rem;\n    --rail-min: 9rem;\n    --duel-field-inset: 0.75rem;\n  }\n}\n\n.diagnostic-message,\n.snapshot-state {\n  margin: 0;\n  color: var(--muted);\n}\n\n.snapshot-state {\n  margin-top: 0.35rem;\n  font-size: 0.78rem;\n}\n\n.message-panel,\n.prompt-panel,\n.event-log,\n.duel-hud {\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background: color-mix(in srgb, var(--surface) 94%, transparent);\n  box-shadow: 0 1rem 3rem color-mix(in srgb, var(--shadow) 16%, transparent);\n}\n\n.message-panel,\n.duel-hud__turn,\n.section-heading,\n.player-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n}\n\n.message-panel,\n.prompt-panel,\n.event-log {\n  padding: 1rem;\n}\n\n.button-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n\n.button-row {\n  justify-content: flex-start;\n  flex-wrap: wrap;\n}\n\n.message-panel h2,\n.duel-hud__turn h2,\n.section-heading h2 {\n  margin-bottom: 0;\n}\n\n.loading-state {\n  width: min(22rem, 55%);\n}\n\n.loading-state p {\n  margin-bottom: 0.35rem;\n  color: var(--muted);\n}\n\nprogress {\n  width: 100%;\n  accent-color: var(--accent);\n}\n\n.error-panel {\n  border-color: var(--danger-border);\n  background: var(--danger-surface);\n}\n\n.error-panel.recoverable {\n  border-color: var(--warning-border);\n  background: var(--warning-surface);\n}\n\n.result-panel {\n  border-color: var(--accent-deep);\n}\n\n.dialog-panel .result-panel,\n.dialog-panel .error-panel {\n  padding: 0;\n  border: none;\n  background: none;\n}\n\n/* A dead duel is the one modal the player cannot dismiss, so the panel itself\n   carries the danger edge the in-flow error panel would have shown. */\n.duel-error-dialog-panel {\n  border-color: var(--danger-border);\n}\n\n.duel-result-dialog-title {\n  color: var(--accent);\n  text-shadow: 0 1px 26px color-mix(in srgb, var(--accent) 30%, transparent);\n}\n\n.duel-error-dialog-title {\n  color: var(--danger);\n}\n\n.restore-failure {\n  margin: 0;\n  color: var(--danger);\n}\n\n.phase-pill {\n  color: var(--bg);\n  border-color: transparent;\n  background: var(--warning);\n  font-weight: 800;\n  text-transform: capitalize;\n}\n\n.workspace-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 1rem;\n}\n\n.prompt-dialog-panel {\n  width: min(36rem, 100%);\n}\n\n.player-heading strong {\n  color: var(--warning);\n  font-size: var(--text-lg);\n}\n\nbutton.card-detail-trigger {\n  min-height: 2rem;\n  padding: 0.2rem 0.35rem;\n  color: var(--accent);\n  border-color: transparent;\n  background: transparent;\n  text-align: left;\n  text-decoration: underline;\n  text-underline-offset: 0.2em;\n}\n\nbutton.card-detail-trigger:hover:not(:disabled) {\n  color: var(--ink);\n  background: transparent;\n}\n\nul,\nol {\n  padding-left: 1.35rem;\n}\n\nli + li {\n  margin-top: 0.35rem;\n}\n\n.empty-copy {\n  margin-bottom: 0;\n  color: var(--muted);\n}\n\n.prompt-panel,\n.event-log {\n  min-width: 0;\n  min-height: 18rem;\n}\n\n.choice-preview,\n.log-scroll {\n  max-height: 20rem;\n  overflow-y: auto;\n  padding-right: 0.5rem;\n}\n\n.log-scroll ol {\n  margin-block: 0;\n}\n\n.log-scroll .is-truncation {\n  color: var(--warning);\n  font-weight: 750;\n}\n\n.duel-hud {\n  container: duel-hud / inline-size;\n  display: grid;\n  gap: 1rem;\n  padding: 1rem;\n  border-color: var(--field-hud-border);\n  background:\n    linear-gradient(\n      135deg,\n      color-mix(in srgb, var(--field-hud-glow) 28%, transparent),\n      transparent 55%\n    ),\n    color-mix(in srgb, var(--surface) 94%, transparent);\n}\n\n.duel-hud__turn {\n  padding-bottom: 0.75rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.duel-hud__players {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 1rem;\n}\n\n.duel-hud__players > article,\n.rich-card-state,\n.chain-status {\n  min-width: 0;\n  padding: 0.85rem;\n  border: 1px solid var(--border);\n  border-radius: 0.75rem;\n  background: var(--surface-chain);\n}\n\n.duel-hud__counts {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.45rem;\n  margin-block: 0.75rem;\n}\n\n.duel-hud__counts div {\n  padding: 0.5rem;\n  border-radius: 0.45rem;\n  background: var(--surface-strong);\n  text-align: center;\n}\n\n.duel-hud__counts dt {\n  color: var(--muted);\n  font-size: var(--text-xs);\n}\n\n.duel-hud__counts dd {\n  margin: 0.15rem 0 0;\n  font-weight: 800;\n}\n\n.duel-hud__trays {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.45rem;\n}\n\n.card-tray-summary > div:first-child,\n.card-tray__heading,\n.card-tray__pagination {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem;\n}\n\n.card-tray-summary {\n  min-width: 0;\n  padding: 0.55rem;\n  border: 1px solid color-mix(in srgb, var(--border) 68%, transparent);\n  border-radius: 0.5rem;\n  background: color-mix(in srgb, var(--surface-raised) 72%, transparent);\n}\n\n.card-tray-summary strong,\n.card-tray-summary span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.card-tray-summary > button,\n.card-tray-summary > .count-only {\n  width: 100%;\n  margin-top: 0.45rem;\n}\n\n.count-only {\n  display: block;\n  color: var(--muted);\n  font-size: var(--text-xs);\n  text-align: center;\n}\n\n.card-tray {\n  position: fixed;\n  z-index: var(--duel-field-layer-menu);\n  inset: 8vh max(1rem, calc((100vw - 72rem) / 2));\n  padding: 1rem;\n  overflow: auto;\n  border: 1px solid var(--accent);\n  border-radius: 0.85rem;\n  background: var(--surface);\n  box-shadow: 0 1rem 4rem color-mix(in srgb, var(--shadow) 62%, transparent);\n}\n\n.card-tray__heading p {\n  margin: 0;\n}\n\n.card-tray__cards {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  gap: 0.65rem;\n  padding: 0;\n  list-style: none;\n}\n\n.card-tray__card {\n  display: grid;\n  width: 100%;\n  height: 100%;\n  align-content: start;\n  gap: 0.35rem;\n  padding: 0.45rem;\n  color: var(--text);\n  border-color: var(--border);\n  background: var(--surface-strong);\n  text-align: left;\n}\n\n.card-tray__card img {\n  width: 100%;\n  aspect-ratio: 59 / 86;\n  object-fit: cover;\n  border-radius: 0.3rem;\n}\n\n.card-tray__pagination {\n  justify-content: center;\n}\n\n.rich-card-state > ul,\n.state-badges,\n.material-summary ol,\n.chain-status ol {\n  margin: 0;\n}\n\n.rich-card-state > ul {\n  display: grid;\n  gap: 0.55rem;\n  padding: 0;\n  list-style: none;\n}\n\n.rich-card-state > ul > li {\n  padding: 0.55rem;\n  border: 1px solid color-mix(in srgb, var(--border) 62%, transparent);\n  border-radius: 0.5rem;\n}\n\n.state-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n  padding: 0;\n  list-style: none;\n}\n\n.state-badges li,\n.chain-status__state {\n  display: inline-block;\n  padding: 0.2rem 0.4rem;\n  border: 1px solid var(--accent);\n  border-radius: 999px;\n  color: var(--text-accent-soft);\n  font-size: 0.75rem;\n}\n\n.material-summary {\n  margin-top: 0.4rem;\n}\n\n.chain-status li + li {\n  margin-top: 0.65rem;\n  padding-top: 0.65rem;\n  border-top: 1px solid var(--border);\n}\n\n.chain-status__provenance {\n  margin-bottom: 0.25rem;\n  color: var(--muted);\n  font-size: 0.78rem;\n  font-weight: 750;\n  text-transform: uppercase;\n}\n\n.chain-status__state {\n  margin-left: 0.5rem;\n}\n\n@media (max-width: 56rem) {\n  .workspace-grid,\n  .duel-hud__players {\n    grid-template-columns: 1fr;\n  }\n\n  .card-tray__cards {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n}\n\n@container duel-hud (max-width: 42rem) {\n  .duel-hud__players {\n    grid-template-columns: 1fr;\n  }\n\n  .duel-hud__trays {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 38rem) {\n  .message-panel,\n  .duel-hud__turn,\n  .section-heading {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .loading-state {\n    width: 100%;\n  }\n\n  .duel-hud__trays,\n  .card-tray__cards {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n/* The board's column: the phase bar on top, the board under it. Both are as\n   wide as the column, so the bar's centre seam falls on the board's own\n   vertical middle without either of them measuring the other. */\n/* No `min-width: 0` and no `overflow: hidden` here on purpose: either one\n   would drop the column's minimum size to zero, and the shell's `auto` track\n   would then shrink under the board's own fixed width and clip it. The board\n   has to keep pushing the track exactly as it did when the slot was the grid\n   item itself. */\n.duel-field-column {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n.duel-field-slot {\n  position: relative;\n  /* Keep the fixed preview and minimum rail inside the 16:9 duel stage budget\n     in upright and rotated modes. `--stage-w` is intentionally unused: this\n     route exposes the full viewport there, while the duel board still follows\n     the stage height's 16:9 width. The phase bar is subtracted from the height\n     instead, because it sits above the board rather than beside it.\n\n     The inset is margin, not padding: `DuelField` sizes the board from this\n     element's `clientWidth`, which padding would shrink and margin does not. */\n  width: calc(\n    var(--stage-h, 100svh) * 16 / 9 - var(--preview-w) - var(--rail-min)\n  );\n  height: calc(100% - var(--phase-bar-h));\n  margin-inline: var(--duel-field-margin, 0px);\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n}\n\n/* Screen-space field-corner controls stay outside the transformed board plane.\n   Anchoring them to the field instead of its slot prevents letterboxing from\n   moving them away from the board. */\n.end-turn-button {\n  position: absolute;\n  right: 0.5rem;\n  bottom: 0.5rem;\n  z-index: var(--duel-field-layer-control);\n  min-inline-size: 44px;\n  min-block-size: 44px;\n  width: max-content;\n  max-width: calc(50% - 1rem);\n  white-space: nowrap;\n}\n\n.end-turn-button.is-armed {\n  border-color: var(--accent);\n  box-shadow:\n    0 0 0 2px var(--surface),\n    0 0 0 4px var(--accent);\n}\n\n.full-control-toggle {\n  position: absolute;\n  left: 0.5rem;\n  bottom: 0.5rem;\n  z-index: var(--duel-field-layer-control);\n  display: inline-flex;\n  gap: 0.3rem;\n  align-items: center;\n  font-size: 0.7rem;\n  color: var(--muted);\n}\n\n/* The caption is the tooltip. Hidden by default and revealed on hover or on\n   focus — clicking the box focuses it, so a click reveals the name too. It is\n   taken out of flow so appearing cannot move the box it names. */\n.full-control-toggle__text {\n  position: absolute;\n  left: 100%;\n  bottom: 0;\n  visibility: hidden;\n  margin-left: 0.3rem;\n  padding: 0.1rem 0.35rem;\n  border: 1px solid var(--border-soft);\n  border-radius: var(--radius-sm);\n  background: color-mix(in srgb, var(--bg) 92%, transparent);\n  white-space: nowrap;\n}\n\n.full-control-toggle:hover .full-control-toggle__text,\n.full-control-toggle:focus-within .full-control-toggle__text {\n  visibility: visible;\n}\n\n/* Ctrl raises Full Control without writing the setting, so the hold is shown\n   next to the box instead of inside it: the tick keeps meaning \"this is what\n   you set\", and the highlight means \"and it is on right now anyway\". */\n.full-control-toggle.is-held {\n  color: var(--accent);\n}\n\n.full-control-toggle__hold:not(:empty) {\n  padding: 0 0.25rem;\n  border: 1px solid var(--accent);\n  border-radius: var(--radius-sm);\n  font-size: 0.65rem;\n  line-height: 1.4;\n}\n\n.duel-field {\n  container: duel-field / inline-size;\n  position: relative;\n  /* One row, so the scroll child claims the field's whole inner height while\n     the field's own box never scrolls: T14 makes it the still boundary every\n     floating window is measured and clamped inside (ADR-017). */\n  display: grid;\n  grid-template-rows: minmax(0, 1fr);\n  min-width: 0;\n  min-height: 0;\n  max-width: 100%;\n  padding: 0;\n  overflow: hidden;\n  border-radius: var(--radius-lg);\n  background: linear-gradient(\n    180deg,\n    var(--surface-field-top),\n    var(--surface-deep)\n  );\n  box-shadow: 0 1rem 3rem color-mix(in srgb, var(--shadow) 18%, transparent);\n}\n\n/* The board keeps a min-width so field targets stay >=44px, so narrow\n   viewports must be able to pan it horizontally; below 79rem a constrained\n   (`.is-duel-viewport`) single-column row can also be shorter than the\n   board's aspect-ratio-driven height, so this child owns the y overflow too.\n   Neither axis is ever owned by the page, and — unlike before T14 — neither is\n   owned by `.duel-field` itself, so panning the board cannot carry a floating\n   window offscreen. */\n.duel-field-scroll-region {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n/* One horizontal timeline above the board. End Turn lives in the field corner;\n   both phase halves stay exact 50% splits so the seam lands on the board's\n   vertical middle. */\n.phase-bar {\n  display: flex;\n  flex-direction: row;\n  height: var(--phase-bar-h);\n  /* Zero width plus a percentage floor: the bar fills the board's column but\n     contributes nothing to it intrinsically, so twelve chips of labels can\n     never widen the column and push the board or the rail out of the shell.\n     The chips shrink inside the bar instead. */\n  width: 0;\n  min-width: 100%;\n  min-height: 0;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n}\n\n.phase-bar__half {\n  flex: 1 1 0;\n  width: 0;\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n  padding: 0 10px;\n}\n\n/* Both halves are strongest at the seam they share, so each gradient runs\n   toward the centre of the bar. */\n.phase-bar__half--opponent {\n  box-shadow: inset 1px 0 var(--border);\n  background: linear-gradient(\n    90deg,\n    color-mix(in srgb, var(--danger) 30%, var(--surface)),\n    color-mix(in srgb, var(--danger) 12%, var(--surface))\n  );\n}\n\n.phase-bar__half--player {\n  background: linear-gradient(\n    270deg,\n    color-mix(in srgb, var(--phase-player) 30%, var(--surface)),\n    color-mix(in srgb, var(--phase-player) 12%, var(--surface))\n  );\n}\n\n.phase-chip {\n  flex: 1 1 0;\n  min-inline-size: 0;\n  min-block-size: 44px;\n  overflow: hidden;\n  display: inline-grid;\n  place-items: center;\n  pointer-events: none;\n  padding: 0.2rem 0.5rem;\n  border: 1px solid transparent;\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--bg) 72%, transparent);\n  color: color-mix(in srgb, var(--muted) 70%, transparent);\n  font-size: var(--text-xs);\n  font-weight: 800;\n  line-height: 1;\n  white-space: nowrap;\n}\n\nbutton.phase-chip:not(:disabled) {\n  min-inline-size: 44px;\n  pointer-events: auto;\n  cursor: pointer;\n}\n\n.phase-chip.is-available {\n  color: var(--ink);\n  border-color: var(--border);\n}\n\n.phase-chip.is-current {\n  box-shadow:\n    0 0 0 2px var(--accent),\n    0 0 0.6rem var(--accent);\n  color: var(--ink);\n}\n\n@media (max-width: 1023.98px) {\n  .phase-bar__half {\n    gap: 2px;\n    padding-inline: 2px;\n  }\n\n  .phase-chip {\n    padding-inline: 0;\n  }\n}\n\n/* Stage uses exact geometry-sized field coordinates. */\n.duel-field-stage {\n  position: relative;\n  width: 100%;\n  height: 100%;\n}\n\n.duel-field-board {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  height: 100%;\n  margin-inline: auto;\n  overflow: hidden;\n  border: 1px solid var(--field-border);\n  border-radius: 0.8rem;\n  background: var(--field-surface);\n}\n\n.duel-field-board__surface {\n  position: absolute;\n  z-index: var(--duel-field-layer-surface);\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(\n      90deg,\n      transparent 49.9%,\n      color-mix(in srgb, var(--field-sheen) 18%, transparent) 50%,\n      transparent 50.1%\n    ),\n    linear-gradient(\n      0deg,\n      transparent 49.8%,\n      color-mix(in srgb, var(--field-sheen) 28%, transparent) 50%,\n      transparent 50.2%\n    ),\n    radial-gradient(\n      circle at center,\n      color-mix(in srgb, var(--accent) 12%, transparent),\n      transparent 30%\n    ),\n    linear-gradient(\n      135deg,\n      var(--field-gradient-from),\n      var(--field-gradient-to)\n    );\n}\n\n.duel-field-board__plane {\n  --hand-upright: 0deg;\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  transform-origin: 50% 100%;\n  transform-style: preserve-3d;\n  pointer-events: none;\n}\n\n.duel-field-board__content {\n  position: absolute;\n  bottom: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  transform-style: preserve-3d;\n  pointer-events: none;\n}\n\n/* In the preserved 3D scene, the content plane must never win hit testing\n   over a projected control. Each positioned interaction owner opts back in. */\n.duel-field-board__content\n  > :is(\n    .duel-field-zone,\n    .duel-field-stack,\n    .duel-field-card,\n    .duel-field-hand-band,\n    .duel-hand-activation-zone\n  ) {\n  pointer-events: auto;\n}\n\n.duel-field-zone,\n.duel-field-stack,\n.duel-field-card {\n  position: absolute;\n  left: var(--field-x);\n  top: var(--field-y);\n  width: var(--field-width);\n  height: var(--field-height);\n  transform: translate(-50%, -50%);\n}\n\n.duel-field-zone {\n  z-index: var(--duel-field-layer-zone);\n  display: grid;\n  place-items: center;\n  padding: 0.2rem;\n  border: 1px solid\n    var(\n      --zone-outline-color,\n      color-mix(in srgb, var(--field-zone-outline) 48%, transparent)\n    );\n  border-radius: var(--radius-sm);\n  background: color-mix(in srgb, var(--field-zone-fill) 28%, transparent);\n  color: color-mix(in srgb, var(--text) 70%, transparent);\n  font-size: clamp(0.42rem, 0.7vw, 0.68rem);\n  line-height: 1.15;\n  text-align: center;\n}\n\n.duel-field-zone--shared {\n  border: 2px solid var(--zone-outline-color, var(--accent));\n  background: color-mix(in srgb, var(--field-zone-shared) 72%, transparent);\n  color: var(--text);\n}\n\n.duel-field-board[data-zone-outlines=\"false\"] {\n  --zone-outline-color: transparent;\n}\n\n.duel-field-board[data-zone-counts=\"false\"] .duel-field-stack__count {\n  display: none;\n}\n\n.duel-field-board[data-zone-labels=\"false\"] .duel-field-zone__label {\n  display: none;\n}\n\n.duel-field-zone__slot {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: calc(var(--field-width) * 0.6923076923 + 6px);\n  height: var(--field-height);\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n}\n\nbutton.duel-field-zone,\n.duel-field-zone.is-actionable {\n  cursor: pointer;\n}\n\n/* Green is the \"you may act on this card\" colour: legal card and zone\n   actions. Orange marks selection, actionable piles (item 12), and the\n   active player — states that answer \"where is the game pointing\", not\n   \"which card is playable\". A card is never orange for legality and a\n   pile is never green, so the two stay readable side by side. Two layers:\n   a near-opaque 3px ring reads as an edge at field scale, and the soft\n   outer glow makes a playable card separate from the board behind it at a\n   glance. The glow carries no spread on purpose — a spread paints a\n   hard-edged band, and a card whose art is rotated (defense, set) leaves\n   that band standing inside the card's own upright box, which reads as a\n   card filled solid green rather than a card wearing a ring. */\n.duel-field-zone.is-actionable,\n.duel-field-card.is-actionable .duel-field-card__art {\n  border-color: var(--success);\n  box-shadow:\n    0 0 0 3px color-mix(in srgb, var(--legal) 90%, transparent),\n    0 0 10px color-mix(in srgb, var(--legal) 40%, transparent);\n}\n\n.duel-field-stack.is-actionable {\n  border-color: var(--selected);\n  box-shadow:\n    0 0 0 3px color-mix(in srgb, var(--selected) 90%, transparent),\n    0 0 10px color-mix(in srgb, var(--selected) 40%, transparent);\n}\n\n/* A drop candidate wears the same green as legality, filled in: the tint is\n   what separates \"you could drop here\" from \"you may act here\". Item 18\n   fades this halo in/out (120ms ease-out, matching T12's hover-zoom\n   duration) rather than snapping every candidate on at once, and the\n   hovered candidate underneath the dragged card gets a distinct, brighter\n   emphasis on top of it. */\n.duel-field-zone.is-drop-candidate {\n  border-color: var(--success);\n  background: color-mix(in srgb, var(--legal) 16%, transparent);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--legal) 75%, transparent);\n  transition:\n    background 120ms ease-out,\n    box-shadow 120ms ease-out;\n}\n\n.duel-field-zone.is-drop-candidate.is-drop-hovered {\n  background: color-mix(in srgb, var(--legal) 34%, transparent);\n  box-shadow: 0 0 0 4px color-mix(in srgb, var(--legal) 95%, transparent);\n}\n\n/* Portrait hand controls overlap the near monster row in screen space. During\n   a real drag, lift only legal candidates one pixel beyond the hand carrier's\n   1px depth so native hit testing resolves the pointed zone. */\n@media (max-width: 1023.98px) and (orientation: portrait) {\n  .duel-field[data-dragging=\"true\"] .duel-field-zone.is-drop-candidate {\n    transform: translate(-50%, -50%) translateZ(2px);\n  }\n}\n\n/* Item 4: the drag-to-activate target. Mounted only mid-drag, at the left end\n   of the hand band, vertically centered on the hand row. It must catch the\n   release hit test, so it never gets pointer-events: none — the drag's pointer\n   capture keeps it from swallowing anything else. Its 2px depth lift clears\n   the hand carrier's 1px lift in the preserved scene. Availability is a fact\n   about the card's choices, never about zone occupancy. */\n.duel-hand-activation-zone {\n  position: absolute;\n  left: var(--field-x);\n  top: var(--field-y);\n  z-index: var(--duel-field-layer-menu);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--field-width);\n  height: var(--field-height);\n  transform: translate(0, -50%) translateZ(2px);\n  border: 2px dashed var(--success);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--legal) 12%, transparent);\n}\n\n.duel-hand-activation-zone__label {\n  color: var(--success);\n  font-size: 0.75rem;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  pointer-events: none;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .duel-field-zone.is-drop-candidate {\n    transition: none;\n  }\n}\n\n.duel-field-card.is-dragging {\n  opacity: 0.72;\n}\n\n/* The ghost is `position:fixed` in viewport coordinates (T9: the app shell\n   itself never scrolls, so this is safe) and stays above every card/chip/\n   field-window layer (menu tops out at 100) but below any future app-level\n   modal/backdrop, which would need a layer above this one. It never\n   receives pointer events, so it cannot poison `elementFromPoint` hit\n   testing while a drag is live. Position/size/rotation are driven inline by\n   the component per pointer frame; the lift scale (1.08) and drop shadow\n   are owned here so a reduced-motion user gets them removed in one place. */\n.drag-ghost {\n  position: fixed;\n  top: 0;\n  left: 0;\n  z-index: var(--duel-field-layer-drag-ghost);\n  pointer-events: none;\n  width: var(--drag-ghost-width);\n  height: var(--drag-ghost-height);\n  transform: translate3d(var(--drag-ghost-x), var(--drag-ghost-y), 0)\n    rotate(var(--drag-ghost-rotate, 0deg))\n    scale(var(--drag-ghost-lift-scale, 1.08));\n  box-shadow: 0 1.5rem 2.5rem color-mix(in srgb, var(--shadow) 55%, transparent);\n}\n\n.drag-ghost__image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .drag-ghost {\n    transition: none;\n    transform: translate3d(var(--drag-ghost-x), var(--drag-ghost-y), 0);\n  }\n}\n\n/* Item 6: the drop that could be read two ways. Centred on the field rather\n   than anchored on the zone, and above the drag ghost, which is springing the\n   card home behind it while the question stands. Everything else is the shared\n   `.dialog-backdrop`/`.dialog-panel` pair the field's other modals use. */\n.drop-confirm-backdrop {\n  z-index: var(--duel-field-layer-drop-confirm);\n}\n\n.drop-confirm-dialog {\n  width: min(20rem, 100%);\n  text-align: center;\n}\n\n.drop-confirm-dialog__zone {\n  margin: 0;\n  color: var(--muted);\n  font-size: 0.85rem;\n}\n\n/* Overlay materials have no field controls of their own. This modal gives each\n   engine choice one art-sized native button while keeping the field visible. */\n.material-select-backdrop {\n  z-index: var(--duel-field-layer-drop-confirm);\n}\n\n.material-select-dialog {\n  width: min(44rem, 100%);\n}\n\n.material-select-dialog__tiles {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));\n  gap: 0.85rem;\n}\n\n.material-select-tile {\n  display: grid;\n  min-width: 0;\n  padding: 0.35rem;\n  border-color: var(--border-strong);\n  background: var(--surface-inset);\n}\n\n.material-select-tile:hover:not(:disabled),\n.material-select-tile:focus-visible {\n  border-color: var(--success);\n}\n\n.material-select-tile.is-selected {\n  border-color: var(--warning);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--selected) 78%, transparent);\n}\n\n.material-select-tile img {\n  display: block;\n  width: 100%;\n  aspect-ratio: 421 / 614;\n  object-fit: cover;\n  border-radius: var(--radius-sm);\n}\n\n.material-select-tile__name {\n  overflow: hidden;\n  margin-top: 0.4rem;\n  color: var(--ink);\n  font-size: 0.75rem;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.material-select-dialog__footer {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  padding-top: 0.75rem;\n  border-top: 1px solid var(--border);\n}\n\n.material-select-dialog__footer output {\n  margin-right: auto;\n  color: var(--muted);\n  font-weight: 700;\n}\n\n/* Anchored on the card's bottom edge at 1.6x, the overlay is drawn *over* the\n   card that opened it. Taking pointer input there would steal that card's own\n   hover and press: the card would report a leave the moment the overlay\n   mounted, and the press meant for the card would land on the art. So the box\n   and everything it draws stay out of hit testing; only the bridge below opts\n   back in, and only above the card. */\n.hand-zoom-overlay {\n  position: fixed;\n  z-index: var(--duel-field-layer-hand-zoom);\n  pointer-events: none;\n}\n\n/* Spans the overlay from the chips' bottom edge down to the anchor card's top\n   edge, and no further. That single span is what lets the pointer reach a chip\n   without ever crossing dead ground and closing the overlay on the way. */\n.hand-zoom-overlay__bridge {\n  position: absolute;\n  top: -0.3rem;\n  right: 0;\n  bottom: var(--hand-zoom-bridge-bottom);\n  left: 0;\n  pointer-events: auto;\n}\n\n.hand-zoom-overlay__art {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  border-radius: 0.28rem;\n}\n\n/* The overlay covers source art, so it repeats semantic card halos on its own\n   art. Card-action legality/selection stay solid green/orange;\n   selection-family legality/selection stay dashed green/orange. */\n.hand-zoom-overlay.is-legal .hand-zoom-overlay__art {\n  border: 3px solid var(--success);\n  box-shadow:\n    0 0 0 3px color-mix(in srgb, var(--legal) 90%, transparent),\n    0 0 10px color-mix(in srgb, var(--legal) 40%, transparent);\n}\n\n.hand-zoom-overlay.is-selected .hand-zoom-overlay__art {\n  border: 3px solid var(--selected);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--selected) 78%, transparent);\n}\n\n.hand-zoom-overlay.is-selection-candidate.is-legal .hand-zoom-overlay__art {\n  border: 3px dashed var(--success);\n  box-shadow: none;\n}\n\n.hand-zoom-overlay.is-selection-candidate.is-selected .hand-zoom-overlay__art {\n  border: 3px dashed var(--selected);\n  box-shadow: none;\n}\n\n.hand-zoom-overlay__name {\n  position: absolute;\n  z-index: var(--duel-field-layer-label);\n  right: -0.1rem;\n  bottom: -0.1rem;\n  left: -0.1rem;\n  overflow: hidden;\n  padding: 0.12rem 0.18rem;\n  border-radius: 0.2rem;\n  color: var(--ink);\n  background: color-mix(in srgb, var(--bg-deeper) 82%, transparent);\n  font-size: clamp(0.38rem, 0.55vw, 0.57rem);\n  line-height: 1.2;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* Override the default display:none on chips so they show inside the overlay.\n   Position, centring and the horizontal transform all come from the shared\n   rule: the overlay's chips sit on the zoomed card exactly the way a field\n   card's sit on it. The overlay box itself is out of hit testing, so the chips\n   have to opt back in on their own. */\n.hand-zoom-overlay .card-action-chips {\n  display: flex;\n  pointer-events: auto;\n}\n\n/* Chips float above the zones and stay visible while their card is hovered,\n   focused or pinned — all of which survive a drag. Taking them out of hit\n   testing for the duration keeps `document.elementFromPoint` on the zone the\n   player is actually pointing at. */\n.duel-field[data-dragging=\"true\"] .card-action-chips {\n  pointer-events: none;\n}\n\n/* Selected overrides plain legal green with orange (orange also marks\n   actionable piles and the active player, per item 12): same token as the\n   list-hover affordance below, but selection is a persisted class, never a\n   :hover pseudo-class, so the two never actually collide on screen. */\n.duel-field-zone.is-selected,\n.duel-field-card.is-selected .duel-field-card__art {\n  border-color: var(--warning);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--selected) 78%, transparent);\n}\n\n/* Item 5: selection candidates wear a dashed outline instead of the solid\n   legality ring — the glow above reads as a green-filled card at field\n   scale. `box-shadow: none` overrides the `.is-actionable` glow; the same\n   dashed weight in orange is the selected state, so selection reads as a\n   colour change, never a shape change. cardAction prompts never carry\n   `.is-selection-candidate` and keep the solid ring. */\n.duel-field-card.is-selection-candidate .duel-field-card__art {\n  border: 3px dashed var(--success);\n  box-shadow: none;\n}\n\n.duel-field-card.is-selection-candidate.is-selected .duel-field-card__art {\n  border-color: var(--selected);\n  box-shadow: none;\n}\n\n/* While a card-targeting prompt is active, hovering a non-candidate field card\n   shows a red ring to signal invalid target — hover-only, never persistent. */\n.duel-field[data-targeting=\"true\"]\n  .duel-field-card:not(.is-actionable):hover\n  .duel-field-card__art {\n  border-color: var(--danger);\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--danger) 60%, transparent);\n}\n\n/* Keyboard focus is a neutral high-contrast ring, independent of the\n   legal/selected palette above. */\n.duel-field-zone.is-navigation-active:focus-visible,\n.duel-field-stack.is-navigation-active:focus-visible,\n.duel-field-card.is-navigation-active:focus-visible,\n.duel-field-card.is-navigation-active:focus-within .duel-field-card__art {\n  outline: 3px solid var(--ink);\n  outline-offset: 2px;\n  box-shadow: 0 0 0 5px color-mix(in srgb, var(--surface-deep) 90%, transparent);\n}\n\n.duel-field-card.is-feedback-target .duel-field-card__art,\n.duel-field-zone.is-feedback-target,\n.duel-field-stack.is-feedback-target {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 72%, transparent);\n}\n\n.field-lines {\n  position: absolute;\n  z-index: var(--duel-field-layer-label);\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n  pointer-events: none;\n}\n\n.field-lines line {\n  stroke: var(--accent);\n  stroke-width: 3;\n  stroke-linecap: round;\n  stroke-dasharray: 7 5;\n  vector-effect: non-scaling-stroke;\n}\n\n.field-lines.is-attack line {\n  stroke: var(--danger);\n  stroke-width: 4;\n}\n\n/* T14 (ADR-017): a field window is absolutely positioned in the field root's\n   padding box — the same coordinate system its persisted `{x, y}` lives in —\n   and translated rather than inset, so dragging never triggers layout. Both\n   caps are relative to that same box, so a window can never start out wider\n   or taller than the boundary it is clamped inside. */\n.floating-field-window {\n  position: absolute;\n  left: 0;\n  top: 0;\n  z-index: var(--duel-field-layer-window);\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  max-width: 100%;\n  max-height: 100%;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background: var(--surface-strong);\n  box-shadow: 0 1rem 3rem color-mix(in srgb, var(--shadow) 45%, transparent);\n  transform: translate(var(--window-x, 0px), var(--window-y, 0px));\n}\n\n/* Ephemeral: the last window the player touched sits above the other one,\n   and both stay below the drag ghost. */\n.floating-field-window.is-active {\n  z-index: var(--duel-field-layer-window-active);\n}\n\n.floating-field-window__handle {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.4rem 0.6rem;\n  border-bottom: 1px solid var(--border);\n  border-radius: var(--radius-lg) var(--radius-lg) 0 0;\n  background: color-mix(in srgb, var(--surface) 90%, transparent);\n  color: var(--muted);\n  font-size: 0.78rem;\n  font-weight: 750;\n  cursor: grab;\n  /* The drag is pointer-captured, so the browser must not claim the gesture\n     for panning first. */\n  touch-action: none;\n  user-select: none;\n}\n\n.floating-field-window.is-dragging .floating-field-window__handle {\n  cursor: grabbing;\n}\n\n.floating-field-window__content {\n  min-width: 0;\n  min-height: 0;\n  padding: 0.6rem;\n  overflow: auto;\n}\n\n.floating-field-window[data-window-id=\"zoneList\"] {\n  width: min(1320px, calc(100% - 16px));\n  height: min(600px, calc(100% - 16px));\n  max-width: calc(100% - 16px);\n  max-height: calc(100% - 16px);\n  grid-template-rows: 58px minmax(0, 1fr);\n  overflow: hidden;\n  border-radius: 14px;\n  box-shadow: 0 28px 80px color-mix(in srgb, var(--shadow) 58%, transparent);\n}\n\n.floating-field-window[data-window-id=\"zoneList\"]\n  > .floating-field-window__handle {\n  padding: 6px 8px 6px 18px;\n}\n\n.floating-field-window[data-window-id=\"zoneList\"][data-mode=\"target\"]\n  > .floating-field-window__handle {\n  padding-left: 6px;\n}\n\n.floating-field-window[data-window-id=\"zoneList\"][data-collapsed=\"true\"] {\n  width: 58px;\n  height: 58px;\n  max-width: 58px;\n  max-height: 58px;\n  grid-template-rows: 58px;\n}\n\n.floating-field-window[data-window-id=\"zoneList\"][data-collapsed=\"true\"]\n  > .floating-field-window__handle {\n  padding: 6px;\n  border-bottom-color: transparent;\n  border-radius: 14px;\n}\n\n.floating-field-window[data-window-id=\"zoneList\"][data-collapsed=\"true\"]\n  > .floating-field-window__content {\n  display: none;\n}\n\n.floating-field-window[data-window-id=\"zoneList\"]\n  > .floating-field-window__content {\n  padding: 0;\n  overflow: hidden;\n}\n\n.zone-list-dialog {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr) 64px;\n  min-width: 0;\n  height: 100%;\n}\n\n.zone-list-dialog__header {\n  display: flex;\n  width: 100%;\n  min-width: 0;\n  align-items: center;\n  gap: 10px;\n}\n\n.zone-list-dialog__header > span {\n  overflow: hidden;\n  color: var(--ink);\n  font-size: 0.96rem;\n  font-weight: 800;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.zone-list-dialog__header > strong {\n  display: inline-grid;\n  place-items: center;\n  min-width: 28px;\n  height: 28px;\n  padding-inline: 8px;\n  border: 1px solid var(--border-strong);\n  border-radius: 999px;\n  background: var(--surface-inset);\n}\n\n.zone-list-dialog__notice {\n  color: var(--muted);\n  font-size: 0.78rem;\n  font-weight: 650;\n}\n\n.zone-list-dialog__collapse,\n.zone-list-dialog__close {\n  min-width: 44px;\n  min-height: 44px;\n  margin-left: auto;\n  padding: 0;\n  font-size: 1.2rem;\n  line-height: 1;\n}\n\n.zone-list-dialog__collapse {\n  flex: 0 0 44px;\n  margin-left: 0;\n  border-color: var(--border-strong);\n  background: var(--surface-inset);\n  color: var(--ink);\n}\n\n.zone-list-dialog__close {\n  min-width: 44px;\n  min-height: 44px;\n}\n\n.zone-list-dialog__entries {\n  display: flex;\n  align-items: flex-start;\n  justify-content: safe center;\n  gap: 8px;\n  min-width: 0;\n  min-height: 0;\n  padding: 92px 8px 42px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  overscroll-behavior-inline: contain;\n  background: var(--surface-panel);\n  scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);\n  scrollbar-width: thin;\n}\n\n.zone-list-dialog__entries::-webkit-scrollbar {\n  height: 12px;\n}\n.zone-list-dialog__entries::-webkit-scrollbar-track {\n  border: 1px solid var(--scrollbar-border);\n  background: var(--scrollbar-track);\n}\n.zone-list-dialog__entries::-webkit-scrollbar-thumb {\n  border: 3px solid var(--scrollbar-border);\n  border-radius: 999px;\n  background: var(--scrollbar-thumb);\n}\n.zone-list-dialog__entries::-webkit-scrollbar-thumb:hover {\n  background: var(--scrollbar-thumb-hover);\n}\n.zone-list-dialog__entries::-webkit-scrollbar-thumb:active {\n  background: var(--scrollbar-thumb-active);\n}\n\n.zone-list-dialog__empty {\n  margin: auto;\n  color: var(--muted);\n}\n\n@media (forced-colors: active) {\n  .zone-list-dialog__entries {\n    scrollbar-color: auto;\n    scrollbar-width: auto;\n  }\n\n  .zone-list-dialog__entries::-webkit-scrollbar {\n    width: auto;\n    height: auto;\n  }\n\n  .zone-list-dialog__entries::-webkit-scrollbar-track {\n    border-color: Canvas;\n    background: Canvas;\n  }\n\n  .zone-list-dialog__entries::-webkit-scrollbar-thumb {\n    border-color: Canvas;\n    background: CanvasText;\n  }\n}\n\n.zone-list-entry {\n  position: relative;\n  flex: 0 0 144px;\n  width: 144px;\n  transition: transform 120ms ease-out;\n  transform-origin: center 42%;\n}\n\n.zone-list-entry.is-first {\n  transform-origin: left 42%;\n}\n.zone-list-entry.is-last {\n  transform-origin: right 42%;\n}\n.zone-list-entry:is(:hover, :focus-within, .is-selected, .is-menu-open) {\n  z-index: 500;\n}\n\n.zone-list-entry.is-actionable img {\n  border-color: var(--success);\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--legal) 55%, transparent);\n}\n\n/* Selected overrides plain legal green with orange — orange is\n   selection/actionable-pile/active-player, never card legality; hover never\n   mutates this class, and no hover rule below repaints a selected entry. */\n.zone-list-entry.is-selected img {\n  border-color: var(--warning);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--selected) 78%, transparent);\n}\n\n/* Actionable hover/focus amplifies the base green ring; selected and neutral\n   entries are excluded so hover never overrides orange or paints neutrals. */\n.zone-list-entry.is-actionable:not(.is-selected):hover img {\n  border-color: var(--success);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--legal) 78%, transparent);\n}\n\n/* Unavailable entries show a red ring (danger, not danger-strong) so the\n   invalid-target language matches the field card targeting halo below. */\n.zone-list-entry.is-unavailable:not(.is-selected) img,\n.zone-list-entry.is-unavailable:not(.is-selected):hover img,\n.zone-list-entry.is-unavailable:not(.is-selected):focus-within img {\n  border-color: var(--danger);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 65%, transparent);\n}\n\n.zone-list-entry:is(:hover, :focus-within, .is-selected, .is-menu-open) {\n  transform: scale(1.6);\n}\n\n.zone-list-entry.is-hover-suppressed {\n  transition: none;\n  transform: none;\n}\n\n.zone-list-entry > img {\n  display: block;\n  width: 144px;\n  aspect-ratio: 421 / 614;\n  border: 2px solid var(--border);\n  border-radius: 6px;\n  object-fit: cover;\n  box-shadow: 0 7px 18px color-mix(in srgb, var(--shadow) 34%, transparent);\n}\n\n.zone-list-entry__name {\n  display: block;\n  margin-top: 8px;\n  overflow: hidden;\n  font-size: var(--text-xs);\n  font-weight: 750;\n  text-align: center;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  transition: opacity 120ms ease-out;\n}\n\n.zone-list-entry:is(:hover, :focus-within, .is-selected, .is-menu-open)\n  .zone-list-entry__name {\n  opacity: 0;\n}\n\n.zone-list-entry:hover .card-action-chips,\n.zone-list-entry:focus-within .card-action-chips,\n.zone-list-entry.is-menu-open .card-action-chips {\n  display: flex;\n}\n\n.zone-list-entry .card-action-chips,\n.projected-choice-menu {\n  top: calc(144px * 614 / 421 - 2px);\n  bottom: auto;\n  /* Reset the card stack's column-reverse: the list keeps its dropdown row. */\n  flex-direction: row;\n  z-index: 10;\n  min-width: 100%;\n  min-height: 34px;\n  border: 1px solid var(--border-soft);\n  border-radius: 6px;\n  background: color-mix(in srgb, var(--bg) 96%, transparent);\n}\n.zone-list-entry.is-first .card-action-chips {\n  left: 0;\n  transform: none;\n}\n.zone-list-entry.is-last .card-action-chips {\n  right: 0;\n  left: auto;\n  transform: none;\n}\n.zone-list-entry .card-action-chip {\n  min-height: 34px;\n  height: 34px;\n  font-size: 0.65rem;\n  font-weight: 850;\n}\n\n.projected-choice-menu {\n  position: absolute;\n  left: 0;\n  display: grid;\n  width: 100%;\n  padding: 2px;\n}\n.projected-choice-menu button {\n  min-height: 34px;\n  font-size: 0.65rem;\n}\n.zone-list-entry__check {\n  position: absolute;\n  z-index: 4;\n  top: 6px;\n  right: 6px;\n  display: grid;\n  width: 24px;\n  height: 24px;\n  place-items: center;\n  border-radius: 50%;\n  background: var(--warning);\n  color: var(--ink-on-warning);\n  font-weight: 900;\n}\n\n/* T16 target mode. The badge names the pile the entry came from, since one\n   list mixes HAND/GY/DECK/BAN/EXTRA. */\n.zone-list-entry__zone {\n  position: absolute;\n  bottom: calc(100% + 4px);\n  left: 0;\n  padding: 3px 6px;\n  border: 1px solid var(--border-light);\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--bg) 90%, transparent);\n  color: var(--ink);\n  font-size: 0.58rem;\n  font-weight: 850;\n  letter-spacing: 0.04em;\n}\n\n.zone-list-entry__targets {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.2rem;\n  margin-top: 0.2rem;\n}\n\n/* Every answer button keeps the 44px minimum target the rest of the field\n   uses; the single-choice case covers the whole tile instead of adding a\n   second control the player has to aim at. */\n.zone-list-entry__target {\n  min-width: 2.75rem;\n  min-height: 2.75rem;\n  padding: 0.2rem 0.35rem;\n  font-size: 0.7rem;\n}\n\n.zone-list-entry__targets.is-single {\n  position: absolute;\n  inset: 0;\n  margin: 0;\n}\n\n.zone-list-entry__targets.is-single .zone-list-entry__target {\n  width: 100%;\n  height: 100%;\n  padding: 0;\n  border-color: transparent;\n  background: transparent;\n}\n\n.zone-list-dialog__footer {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n  padding: 10px 16px;\n  border-top: 1px solid var(--border);\n}\n\n.zone-list-dialog__footer output {\n  font-weight: 700;\n}\n.zone-list-dialog__sort {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  margin-left: auto;\n  color: var(--muted);\n  font-size: 0.75rem;\n}\n.zone-list-dialog__sort input {\n  width: 18px;\n  height: 18px;\n}\n.zone-list-dialog__cancel {\n  min-height: 44px;\n}\n\n.duel-field-stack {\n  z-index: var(--duel-field-layer-stack);\n  display: grid;\n  min-width: 2.875rem;\n  min-height: 2.75rem;\n  align-content: center;\n  justify-items: center;\n  gap: 0.1rem;\n  padding: 0.2rem;\n  border: 2px solid var(--stack-accent);\n  border-radius: 0.4rem;\n  background:\n    linear-gradient(\n      145deg,\n      color-mix(in srgb, var(--stack-accent) 24%, transparent),\n      transparent 65%\n    ),\n    var(--stack-surface);\n  color: var(--text);\n  text-transform: capitalize;\n  overflow: hidden;\n}\n\n/* A stack renders as a real `<button>` whenever it holds any card, so it can\n   open a browsable pile even with no legal target inside — the generic\n   `button:hover` reset above would otherwise paint every hovered pile with\n   the accent fill, whether or not it wears the `.is-actionable` ring. The\n   ring alone is the legality signal here; hover repeats the resting\n   background instead of overriding it. */\n.duel-field-stack:hover:not(:disabled):not(.is-empty) {\n  background:\n    linear-gradient(\n      145deg,\n      color-mix(in srgb, var(--stack-accent) 24%, transparent),\n      transparent 65%\n    ),\n    var(--stack-surface);\n}\n\n/* Item 2 (2026-09-02, owner): a pile holding no cards is a zone with nothing\n   in it, so it wears the neutral zone outline and fill of an empty\n   `.duel-field-zone` rather than the purple pile chrome, which reads as a\n   card lying face down there. Name and count still show — the zone says what\n   it is and that it holds zero. Hover is excluded above for the same reason:\n   an empty pile is a `<div>`, still hoverable, and must not light up purple. */\n.duel-field-stack.is-empty {\n  border: 1px solid\n    var(\n      --zone-outline-color,\n      color-mix(in srgb, var(--field-zone-outline) 48%, transparent)\n    );\n  background: var(--field-zone-fill);\n}\n\n.duel-field-stack__art {\n  position: absolute;\n  z-index: 0;\n  inset: 0;\n  opacity: 0.85;\n}\n\n.duel-field-stack__art img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  border-radius: var(--radius-sm);\n  display: block;\n}\n\n.duel-field-stack__name,\n.duel-field-stack__count {\n  position: relative;\n  z-index: 1;\n  text-shadow: 0 1px 2px color-mix(in srgb, var(--bg-deep) 90%, transparent);\n}\n\n.duel-field-stack__name {\n  max-width: 100%;\n  overflow: hidden;\n  color: var(--muted);\n  font-size: clamp(0.45rem, 0.72vw, 0.72rem);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.duel-field-stack__count {\n  font-size: clamp(0.7rem, 1.15vw, 1.1rem);\n}\n\n.duel-field-card {\n  z-index: var(--duel-field-layer-card);\n  min-width: 2.75rem;\n  box-shadow: 0 2px 8px color-mix(in srgb, var(--shadow) 55%, transparent);\n  min-height: 2.75rem;\n  margin: 0;\n  pointer-events: auto;\n  transform-origin: center;\n  transition: transform 120ms ease-out;\n}\n\n.duel-field-board[data-card-shadows=\"false\"] .duel-field-card {\n  box-shadow: none;\n}\n\n/* Hovered/focused/pinned card parent rises above normal card/stack/zone\n   siblings (all z-index 30/20/10): with `.duel-field-board { isolation:\n   isolate }`, a chip's own z-index only ranks it among its own card's\n   children, never against a whole sibling card painted later in the DOM. */\n.duel-field-card:is(:hover, :focus-within),\n.duel-field-card.is-pinned {\n  z-index: var(--duel-field-layer-card-raised);\n}\n\n/* Hand cards live in normal document flow inside a HandBand's scrolling\n   viewport, not absolutely positioned by board coordinates. The viewport's\n   overflow flattens its descendants, so cards keep only their 2D fan/droop;\n   the non-scrolling band carries the 3D camera counter-tilt below. Two classes\n   outweigh the shared `.duel-field-zone, .duel-field-stack, .duel-field-card`\n   group above (one class each), so this always wins regardless of source\n   order. */\n.duel-field-card.is-hand-item {\n  --hand-card-halo-gap: 0.35rem;\n  --hand-card-height: calc(var(--field-height) - var(--hand-card-halo-gap));\n\n  position: relative;\n  top: auto;\n  left: auto;\n  flex: 0 0 calc(var(--hand-card-height) * 72 / 104);\n  width: calc(var(--hand-card-height) * 72 / 104);\n  height: var(--hand-card-height);\n  min-width: 0;\n  min-height: 0;\n  margin-top: var(--hand-card-halo-gap);\n  transform: rotate(var(--card-fan, 0deg)) translateY(var(--card-droop, 0px));\n  transform-origin: center bottom;\n}\n\n.duel-field-card.is-hand-item.is-opponent {\n  transform-origin: center top;\n}\n\n/* Board cards no longer zoom on hover; a focused hand card keeps its in-place\n   lift so keyboard users see which card holds focus. Pinned cards are\n   excluded: pinning moves focus onto a card-action-chips button, and scaling\n   then can push that chip outside the viewport. */\n.duel-field-card.is-identity-known.is-hand-item:not(.is-pinned):focus-within {\n  transform: scale(1.35) rotate(var(--card-fan, 0deg))\n    translateY(var(--card-droop, 0px));\n}\n\n/* Auto-margin centering: the free space is absorbed on the outer side of the\n   cluster's two end cards, so the cards stay adjacent and centered while they\n   fit, and the margins collapse to zero — leaving the scroll extent untouched\n   — once they no longer do. The opponent's band is `row-reverse`, which puts\n   its first child on the right, so each band takes the auto margin on the\n   opposite physical side; pairing both bands on the same side lands them\n   inside the cluster and spreads the opponent's cards to the band edges.\n   `justify-content: safe center` cannot replace this: `safe` falls back to\n   writing-mode start, not flex start, which leaves a mirrored band's overflow\n   outside its scrollable area. */\n.duel-field-hand-band:not(.is-opponent)\n  .duel-field-hand-band__viewport\n  > .duel-field-card.is-hand-item:first-child,\n.duel-field-hand-band.is-opponent\n  .duel-field-hand-band__viewport\n  > .duel-field-card.is-hand-item:last-child {\n  margin-left: auto;\n}\n\n.duel-field-hand-band:not(.is-opponent)\n  .duel-field-hand-band__viewport\n  > .duel-field-card.is-hand-item:last-child,\n.duel-field-hand-band.is-opponent\n  .duel-field-hand-band__viewport\n  > .duel-field-card.is-hand-item:first-child {\n  margin-right: auto;\n}\n\n/* Item 5: the hand and its action chips must never be painted over by a\n   field card, zone, stack, or in-field control. This box creates its own\n   stacking context (position + z-index), so its z-index must outrank every\n   field-layer token up through --duel-field-layer-control — the child chip's\n   own --duel-field-layer-menu z-index only orders siblings inside this\n   context; it cannot rescue a lower-z-index parent. It also participates\n   directly in the preserved board plane as the counter-tilt carrier; its\n   scrolling viewport stays a descendant, where flattening is harmless. A\n   1px depth lift keeps its controls ahead of coplanar siblings for 3D hit\n   testing while the existing z-index controls paint order. */\n.duel-field-hand-band {\n  position: absolute;\n  left: var(--field-x);\n  top: var(--field-y);\n  z-index: var(--duel-field-layer-menu);\n  width: var(--field-width);\n  height: var(--field-height);\n  transform: translate(-50%, -50%) translateZ(1px)\n    rotateX(var(--hand-upright, 0deg));\n}\n\n/* The fan drops its outer cards below the band box — the droop translation\n   plus the rotation sweep of the bottom corner — and `overflow-y: hidden`\n   clips at the padding edge, not the content edge. So the padding alone would\n   only shrink the content box under the global `border-box` and leave the\n   clip where it was; growing the height by the same amount moves the clip\n   edge under the deepest card corner while the content box stays at the band\n   height, so card layout and the scroll extent are untouched. Both bands\n   droop downward (`droopPxFor` is player-agnostic and positive), so the one\n   headroom serves the opponent's mirrored fan too. `--hand-card-height`\n   arrives from the band root: the card's own declaration of it is a\n   descendant, and custom properties inherit downward only. Measured in\n   headless Chromium 1.61.1 on 2026-09-02 at 1920x1080: the outermost card of\n   a five card hand overflowed a 0.14 headroom by 3.22px (own band) and 1.43px\n   (opponent band), because the deepest corner is the 0.12 droop plus the\n   sweep of the bottom corner through the 6deg fan; 0.17 clears both. */\n.duel-field-hand-band__viewport {\n  display: flex;\n  gap: var(--zone-gap);\n  width: 100%;\n  height: calc(100% + var(--hand-card-height) * 0.17);\n  min-width: 0;\n  padding-bottom: calc(var(--hand-card-height) * 0.17);\n  overflow-x: auto;\n  overflow-y: hidden;\n  overscroll-behavior-x: contain;\n  scrollbar-width: none;\n}\n\n.duel-field-hand-band__viewport::-webkit-scrollbar {\n  display: none;\n}\n\n.duel-field-hand-band.is-opponent .duel-field-hand-band__viewport {\n  flex-direction: row-reverse;\n}\n\n.overlay-scrollbar {\n  position: absolute;\n  z-index: var(--duel-field-layer-control);\n  pointer-events: none;\n}\n\n.overlay-scrollbar.is-horizontal {\n  right: 0;\n  bottom: 0;\n  left: 0;\n  height: 0.3rem;\n}\n\n/* Opponent hand faces inward from board top. Its bottom edge projects across\n   spell/trap zones, which win 3D hit testing before thumb pointer capture can\n   start. Mirror the thumb onto the hand's outward edge instead. */\n.duel-field-hand-band.is-opponent > .overlay-scrollbar.is-horizontal {\n  top: 0;\n  bottom: auto;\n}\n\n.overlay-scrollbar.is-vertical {\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 0.3rem;\n}\n\n.overlay-scrollbar__thumb {\n  border-radius: 999px;\n  pointer-events: auto;\n  touch-action: none;\n  background: color-mix(in srgb, var(--accent) 75%, transparent);\n}\n\n.overlay-scrollbar.is-horizontal .overlay-scrollbar__thumb {\n  height: 100%;\n}\n\n.overlay-scrollbar.is-vertical .overlay-scrollbar__thumb {\n  width: 100%;\n}\n\n@media (forced-colors: active) {\n  .overlay-scrollbar__thumb {\n    forced-color-adjust: none;\n    background: CanvasText;\n  }\n}\n\n/* Xyz materials fan out Duel Links style: each material is a full-size\n   card slid 12% of the card width further right per step, painted at\n   z-index -1 so it sits behind the art inside the card's own stacking\n   context (the card root's z-index makes it one) yet above the board. */\n.duel-field-card__material {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  overflow: hidden;\n  border: 1px solid color-mix(in srgb, var(--field-card-edge) 78%, transparent);\n  border-radius: 0.28rem;\n  background: var(--surface-strong);\n  box-shadow: 0 0.35rem 0.8rem\n    color-mix(in srgb, var(--shadow) 32%, transparent);\n  transform: translateX(calc((var(--material-index) + 1) * 12%));\n  pointer-events: none;\n}\n\n.duel-field-card__material img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.duel-field-card.is-opponent .duel-field-card__material img {\n  transform: rotate(180deg);\n}\n\n.duel-field-card__art {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  border: 1px solid color-mix(in srgb, var(--field-card-edge) 78%, transparent);\n  border-radius: 0.28rem;\n  background: var(--surface-strong);\n  box-shadow: 0 0.35rem 0.8rem\n    color-mix(in srgb, var(--shadow) 32%, transparent);\n  transform-origin: center;\n}\n\n.duel-field-card__art img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.duel-field-stack.is-opponent .duel-field-stack__art img {\n  transform: rotate(180deg);\n}\n\n.duel-field-card.is-defense .duel-field-card__art,\n.duel-field-card.is-set .duel-field-card__art {\n  transform: rotate(90deg);\n}\n\n.duel-field-card.is-opponent:not(.is-sideways) .duel-field-card__art {\n  transform: rotate(180deg);\n}\n\n.duel-field-card.is-opponent:is(.is-defense, .is-set) .duel-field-card__art {\n  transform: rotate(270deg);\n}\n\n.duel-field-card__label {\n  position: absolute;\n  z-index: var(--duel-field-layer-label);\n  right: -0.1rem;\n  bottom: -0.1rem;\n  left: -0.1rem;\n  overflow: hidden;\n  padding: 0.12rem 0.18rem;\n  border-radius: 0.2rem;\n  color: var(--ink);\n  background: color-mix(in srgb, var(--bg-deeper) 82%, transparent);\n  font-size: clamp(0.38rem, 0.55vw, 0.57rem);\n  line-height: 1.2;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* The band's viewport clips its overflow, and a hand card fills the band's\n   full height, so the legality halo painted outside the card's own box had\n   nowhere to land. The gap above shortens the card by exactly what the ring\n   needs and spends it as top margin. The label overhangs the art by 0.1rem\n   and covered the ring along the bottom edge, so inside the band it tucks\n   back inside the art instead. */\n.duel-field-card.is-hand-item .duel-field-card__label {\n  right: 0.16rem;\n  bottom: 0.16rem;\n  left: 0.16rem;\n}\n\n.duel-field-card__target {\n  position: absolute;\n  z-index: var(--duel-field-layer-control);\n  inset: 0;\n  min-width: max(100%, 2.75rem);\n  min-height: max(100%, 2.75rem);\n  padding: 0;\n  border: 0;\n  border-radius: 0.3rem;\n  background: transparent;\n  cursor: pointer;\n}\n\n/* Chips sit on top of the card, anchored to its bottom edge and growing\n   upward: `column-reverse` keeps prompt order in the DOM while drawing the\n   first choice nearest the bottom. The stack is capped at the card's own\n   height and scrolls past that, so it always stays inside the card's box —\n   there is no gap at all for a pointer travelling from card to chip to\n   cross, and the `:hover` that reveals them can never be dropped in\n   transit. Every other host of this class — the zone list — sets its own\n   `top`/`bottom` pair and keeps its own anchor. */\n.card-action-chips {\n  position: absolute;\n  z-index: var(--duel-field-layer-menu);\n  top: auto;\n  bottom: 0;\n  left: 50%;\n  display: none;\n  flex-direction: column-reverse;\n  height: fit-content;\n  max-height: 100%;\n  gap: 0.15rem;\n  padding: 0.12rem;\n  border-radius: 0.3rem;\n  background: color-mix(in srgb, var(--bg) 92%, transparent);\n  transform: translateX(-50%);\n  overflow-y: auto;\n}\n\n/* The hand zoom overlay hands its chips a whole enlarged card box, so they\n   stop competing for space and take one full-width row each — still bottom-\n   anchored and growing upward, the same reading order as a field card's own\n   stack. Declared after the overlay's own `display: flex` rule above, which\n   it carries the same specificity as and therefore overrides on source\n   order alone — do not hoist it. */\n.card-action-chips.is-stacked {\n  display: flex;\n  flex-direction: column-reverse;\n  gap: var(--space-1);\n  width: var(--hand-zoom-width);\n  padding: 0;\n}\n\n/* Always mounted for an actionable card — or for a card carrying a local\n   action, the rule below — merely hidden: assertions about dismissal must\n   test visibility, never element count. */\n.duel-field-card.is-actionable:hover .card-action-chips,\n.duel-field-card.is-actionable:focus-within .card-action-chips,\n.duel-field-card.is-pinned .card-action-chips {\n  display: flex;\n}\n\n/* A local action answers no prompt, so its host never becomes actionable and\n   every reveal path above misses it: without this rule the Materials chip of\n   a prompt-free Xyz monster would mount and stay `display: none` forever.\n   Kept as its own rule so the group above stays the exact prompt-reveal set.\n   There is no pin arm: a pin belongs to a decision, and this card is in\n   none. */\n.duel-field-card.has-local-actions:hover .card-action-chips,\n.duel-field-card.has-local-actions:focus-within .card-action-chips {\n  display: flex;\n}\n\n/* Hand hover opens the overlay instead; suppress the clipped in-band chips\n   on plain hover so they do not peek out below the overlay. Focus and pin\n   keep their own reveal path (the rule above) — except while the overlay is\n   actually serving this card (`is-zoom-served`, set from the mounted\n   overlay's target): then the overlay's stack is the one chip set on\n   screen, whatever :focus-within or the pin say. The keyboard pin mounts no\n   overlay, so its in-band chips survive this rule untouched (ADR-032 §4). */\n.duel-field-card.is-hand-item:not(:focus-within):not(.is-pinned):hover\n  .card-action-chips,\n.duel-field-card.is-actionable.is-hand-item.is-zoom-served .card-action-chips {\n  display: none;\n}\n\n/* Chips drawn over a card — the field/hand card itself and the hand zoom\n   overlay of one — get 1.5x the shared size: unlike a list row's chip, this\n   button has to read as a target from across the board. The zone list keeps\n   the smaller size below. */\n.duel-field-card .card-action-chip,\n.hand-zoom-overlay .card-action-chip {\n  min-width: 5.1rem;\n  min-height: 1.725rem;\n  height: 1.725rem;\n  padding: 0 0.45rem;\n  border-radius: 0;\n  font-size: 0.825rem;\n}\n\nbutton.card-action-chip {\n  min-width: 3.4rem;\n  min-height: 1.15rem;\n  height: 1.15rem;\n  padding: 0 0.3rem;\n  border: 1px solid var(--gold-line);\n  border-radius: 0;\n  color: var(--ink-on-warning);\n  background: var(--warning);\n  cursor: pointer;\n  font-size: 0.55rem;\n  font-weight: 800;\n  line-height: 1;\n  white-space: nowrap;\n}\n\nbutton.card-action-chip:hover:not(:disabled) {\n  background: var(--selected-strong);\n}\n\nbutton.card-action-chip:focus-visible {\n  outline: 2px solid var(--focus-ring);\n  outline-offset: 2px;\n}\n\nbutton.card-action-chip:disabled {\n  border-color: var(--border-soft);\n  color: var(--muted);\n  background: var(--neutral);\n  cursor: not-allowed;\n  opacity: 1;\n}\n\n/* T14: the bar is normal flow inside the confirm window (ADR-017), which\n   owns placement, so the bar itself only describes its own content box. */\n.field-action-bar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n  max-width: 100%;\n}\n\n.field-action-bar p {\n  margin: 0;\n  font-size: 0.8rem;\n}\n\n.field-action-bar [data-cy=\"field-action-bar-list\"] {\n  display: grid;\n  gap: 0.3rem;\n  max-height: 9rem;\n  overflow: auto;\n  width: 100%;\n}\n\n.field-action-bar [data-cy=\"field-action-bar-validation\"] {\n  color: var(--danger);\n  width: 100%;\n}\n\n.field-error {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1rem;\n  border: 1px solid var(--danger);\n  border-radius: 0.8rem;\n  background: color-mix(in srgb, var(--danger-deep) 32%, transparent);\n}\n\n@media (max-width: 48rem) {\n  .field-error {\n    align-items: stretch;\n    grid-template-columns: 1fr;\n    flex-direction: column;\n  }\n}\n\n@media (max-width: 38rem), (max-height: 30rem) {\n  .card-tray {\n    inset: max(0.5rem, env(safe-area-inset-top))\n      max(0.5rem, env(safe-area-inset-right))\n      max(0.5rem, env(safe-area-inset-bottom))\n      max(0.5rem, env(safe-area-inset-left));\n    padding: 0.75rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n    transition-duration: 0.01ms !important;\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n}\n\n/* T12: the global reduced-motion block above only zeroes transition\n   *duration* (a11y baseline for every animated property in the app); the\n   1.35x hover/focus zoom also needs its transform disabled outright, or a\n   reduced-motion user still jumps to the scaled size instantly. Static\n   halos (border-color/box-shadow above) are untouched. Opponent/sideways\n   art rotation lives on `.duel-field-card__art`, a different element, so it\n   is never touched here and stays oriented. */\n@media (prefers-reduced-motion: reduce) {\n  .duel-field-card,\n  .zone-list-entry {\n    transition: none;\n  }\n\n  .duel-field-card.is-identity-known:not(.is-hand-item):not(.is-pinned):is(\n      :hover,\n      :focus-within\n    ) {\n    transform: translate(-50%, -50%);\n  }\n\n  .zone-list-entry:is(:hover, :focus-within, .is-selected, .is-menu-open) {\n    transform: none;\n  }\n\n  .duel-field-card.is-identity-known.is-hand-item:not(.is-pinned):focus-within {\n    transform: rotate(var(--card-fan, 0deg)) translateY(var(--card-droop, 0px));\n  }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"app","data-app-shell":"ready"},["DIV",{"class":"app-stage","data-cy":"app-stage","data-stage-mode":"stage","data-stage-route":"home"}," "," ",["DIV",{"class":"shell-region shell-region--home","data-cy":"shell-region-home"},["MAIN",{"class":"main-menu","data-cy":"main-menu-screen"}," ",["P",{"class":"main-menu__eyebrow","data-cy":"main-menu-eyebrow"},"Private prototype · v0.1"]," ",["H1",{"class":"main-menu__title","data-cy":"main-menu-title"},"ASCEN",["B",{"data-cy":"main-menu-title-accent"},"CIO"]]," ",["P",{"class":"main-menu__tagline","data-cy":"main-menu-tagline"},"One signal. One duel. More than one way forward."]," ",["NAV",{"class":"main-menu__entries","aria-label":"Main menu","data-cy":"main-menu-entries"},["BUTTON",{"type":"button","data-cy":"main-menu-new-game","disabled":"","title":"Checking installed content…"},"New Game"]," ",["BUTTON",{"type":"button","data-cy":"main-menu-continue","disabled":"","title":"Checking installed content…"},"Continue"]," ",["BUTTON",{"type"