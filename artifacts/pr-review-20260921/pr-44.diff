+export async function installShellPrecache(
+  firstInstall: boolean,
+  install: () => Promise<unknown>,
+  removeIncompleteCache: () => Promise<unknown>,
+): Promise<void> {
+  try {
+    await install();
+  } catch (error) {
+    if (firstInstall) await removeIncompleteCache();
+    throw error;
+  }
+}
