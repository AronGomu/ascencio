{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YGO Story Duel Simulator",
  "version": "0.1.0",
  "identifier": "com.ascencio.storyduel",
  "build": {
    "beforeDevCommand": "npm run native:prepare && npm run dev -- --mode native",
    "devUrl": "http://127.0.0.1:4204",
    "beforeBuildCommand": "npm run native:prepare && npm run build && npm run native:verify-staged",
    "frontendDist": "../generated/build/app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YGO Story Duel Simulator",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/game-content/": "game-content/"
    }
  }
}
