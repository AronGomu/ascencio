+async function measureAcceptedUpdatePaint(page: Page) {
+  return page.evaluate(async () => {
+    const events = window.__duelCapture.events as unknown as DuelWorkerEvent[];
+    const previous = events.findLast((event) => event.type === "state");
+    const prompt = events.findLast((event) => event.type === "prompt");
+    if (previous?.type !== "state" || prompt?.type !== "prompt")
+      throw new Error("DF-16 requires a live public state and prompt");
+    const update = structuredClone(previous);
+    // No production telemetry: a unique visible turn identifies this revision.
+    const revision = previous.state.revision + 1;
+    const turn = previous.state.turn + 1;
+    const state = { ...update.state, revision, turn };
+    const marker = document.querySelector('[data-cy="duel-hud-turn-eyebrow"]');
+    if (!marker || marker.textContent?.trim() !== `Turn ${previous.state.turn}`)
+      throw new Error("DF-16 previous revision is not rendered");
+    const receivedAt = performance.now();
+    let renderedAt = 0;
+    await new Promise<void>((resolve, reject) => {
+      const observer = new MutationObserver(() => {
+        if (marker.textContent?.trim() !== `Turn ${turn}`) return;
+        renderedAt = performance.now();
+        observer.disconnect();
+        clearTimeout(timeout);
+        resolve();
+      });
+      const timeout = setTimeout(() => {
+        observer.disconnect();
+        reject(new Error(`DF-16 revision ${revision} did not render`));
+      }, 5_000);
+      observer.observe(marker, {
+        childList: true,
+        characterData: true,
+        subtree: true,
+      });
+      // The actual DuelWorkerClient parser/reducer/Svelte path must accept it.
+      window.__duelWorker.dispatchEvent(
+        new MessageEvent("message", {
+          data: { type: "state", state },
+        }),
+      );
+      window.__duelWorker.dispatchEvent(
+        new MessageEvent("message", { data: prompt }),
+      );
+    });
+    await new Promise<void>((resolve) => {
+      requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
+    });
+    const paintedAt = performance.now();
+    if (marker.textContent?.trim() !== `Turn ${turn}`)
+      throw new Error(`DF-16 revision ${revision} changed before paint`);
+    return {
+      revision,
+      turn,
+      receivedAt,
+      renderedAt,
+      paintedAt,
+      duration: paintedAt - receivedAt,
+    };
+  });
 }
 
