{
  "name": "ascencio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "legacy:assets:copy-migrate": "node scripts/migrate-assets.ts",
    "legacy:assets:copy-to-package-roots": "node scripts/restructure-assets.ts",
    "assets:bootstrap": "node scripts/download-mvp-assets.ts",
    "assets:engine:acquire": "node scripts/sync-engine.ts",
    "assets:engine:verify-acquired": "node scripts/verify-engine.ts",
    "assets:upstream:sync": "node scripts/sync-assets.ts",
    "assets:verify-all": "node scripts/verify-assets.ts && npm run assets:sets:verify-images && npm run assets:cards:verify-full",
    "assets:cards:download-full": "node scripts/download-images.ts",
    "assets:cards:download-cropped": "node scripts/download-images.ts --kind cropped",
    "assets:cards:download-cropped-reviewed-pool": "node scripts/download-images.ts --kind cropped --active",
    "assets:cards:verify-full": "node scripts/verify-images.ts",
    "assets:card-back:download": "node scripts/download-card-back.ts",
    "assets:sets:download-images": "node scripts/download-set-images.ts",
    "assets:sets:verify-images": "node scripts/verify-set-images.ts",
    "assets:images:pin": "node scripts/generate-image-lock.ts",
    "vendor:verify": "node scripts/verify-vendor.ts",
    "content:source-manifest:generate": "node scripts/generate-runtime-snapshot.ts",
    "content:source-manifest:verify": "node scripts/verify-runtime-snapshot.ts",
    "content:shop-sets:fetch-and-generate": "node scripts/generate-shop-sets.ts",
    "frontend:dev": "vite --config config/vite.config.ts",
    "prebrowser:dev": "node scripts/prepare-browser-content.ts",
    "browser:dev": "vite --config config/vite.config.ts --mode browser-dev",
    "frontend:build": "npm run vendor:verify && npm run frontend:bundle && npm run frontend:verify",
    "frontend:bundle": "vite --config config/vite.config.ts build --mode native",
    "frontend:verify": "node scripts/verify-native-build.ts",
    "frontend:verify-reproducible": "node scripts/verify-reproducible-build.ts",
    "frontend:preview": "vite --config config/vite.config.ts preview",
    "format": "prettier --config config/prettier.config.js --write \"src/**/*.{ts,svelte,css}\" \"test/**/*.{ts,svelte}\" \"scripts/**/*.ts\" \"*.{js,json,ts}\" \"config/**/*.{js,json,ts}\" \"src/**/*.html\" \"test/**/*.html\"",
    "format:check": "prettier --config config/prettier.config.js --check \"src/**/*.{ts,svelte,css}\" \"test/**/*.{ts,svelte}\" \"scripts/**/*.ts\" \"*.{js,json,ts}\" \"config/**/*.{js,json,ts}\" \"src/**/*.html\" \"test/**/*.html\"",
    "lint": "eslint --config config/eslint.config.js .",
    "typecheck": "tsc --project config/tsconfig.json --noEmit && svelte-check --tsconfig ./config/tsconfig.json --config ./config/vite.config.ts",
    "test:tooling": "node --test test/tooling/*.test.ts",
    "test:unit-and-performance": "vitest run -c test/config/vitest.config.ts test/unit --exclude test/unit/decks/deck-catalog-performance.test.ts && vitest run -c test/config/vitest.config.ts test/unit/decks/deck-catalog-performance.test.ts",
    "test:component": "vitest run -c test/config/vitest.config.ts test/component",
    "test:integration": "vitest run -c test/config/vitest.config.ts test/integration",
    "test:browser:native-bridge": "playwright test -c test/config/playwright.native.config.ts",
    "test:browser:visual-acceptance": "playwright test -c test/config/playwright.acceptance.config.ts",
    "test:browser:collection": "node test/runner/verify-browser-collection.ts",
    "test:browser:resources": "playwright test -c test/config/playwright.resource.config.ts",
    "test:release:readiness": "vitest run -c test/config/vitest.release.config.ts",
    "test:runner-timing": "vitest run -c test/config/vitest.config.ts --reporter=default --reporter=./test/runner/lib/test-timing-reporter.ts",
    "test": "node test/runner/run-tests.ts",
    "test:all": "npm run test:tooling && npm run test:unit-and-performance && npm run test:component && npm run test:integration",
    "test:changed": "node test/runner/run-tests.ts",
    "test:context": "node test/runner/test-context.ts",
    "check:headless": "npm run format:check && npm run lint && npm run typecheck && npm run test:tooling && npm run test:unit-and-performance && npm run test:integration && npm run vendor:verify && npm run assets:verify-all && npm run content:source-manifest:verify",
    "check:frontend-and-browser": "npm run test:browser:collection && npm run test:component && npm run frontend:build && npm run frontend:verify-reproducible && npm run test:browser:native-bridge && npm run test:browser:visual-acceptance",
    "check": "npm run check:headless && npm run check:frontend-and-browser",
    "content:convert:sqlite-to-json": "node scripts/readable-content.ts convert",
    "content:compile:json": "node scripts/readable-content.ts compile",
    "content:verify:sqlite-json-parity": "node scripts/verify-readable-parity.ts",
    "mods:bundle": "node scripts/package-mod.ts",
    "mods:audit:wasm-imports": "node scripts/audit-mod-runtime.ts",
    "legacy:content:export-sqlite": "node scripts/export-content-packages.ts",
    "legacy:content:verify-sqlite": "node scripts/verify-content-package.ts",
    "content:release:pin": "node scripts/readable-content-release.ts manifest",
    "content:stage:native": "node scripts/readable-content-release.ts prepare",
    "content:stage:verify-native": "node scripts/readable-content-release.ts verify-staged",
    "content:stage:cleanup": "node scripts/clean-native-content.ts",
    "native:desktop:dev": "tauri dev",
    "native:build-and-start:linux": "node scripts/start-desktop.ts",
    "native:desktop:build": "tauri build",
    "native:android:dev": "tauri android dev",
    "native:android:build": "tauri android build",
    "native:ios:dev": "tauri ios dev",
    "native:ios:build": "tauri ios build",
    "test:native:rust": "cargo test --manifest-path tauri/Cargo.toml",
    "test:native:io-acceptance": "node test/runner/native/test-native-io-acceptance.ts",
    "setup": "node scripts/setup-desktop.ts",
    "hooks:install": "node scripts/install-git-hooks.ts",
    "commit:validate": "node scripts/validate-commit.ts",
    "build": "tauri build --no-bundle",
    "start": "node scripts/start-desktop.ts",
    "bot:improve": "cargo run --release --manifest-path tools/bot-evaluation/Cargo.toml -- improve",
    "bot:evaluate": "cargo run --release --manifest-path tools/bot-evaluation/Cargo.toml -- evaluate",
    "bot:compare": "cargo run --release --manifest-path tools/bot-evaluation/Cargo.toml -- compare",
    "bot:benchmark": "cargo run --release --manifest-path tools/bot-evaluation/Cargo.toml -- benchmark",
    "bot:analyses": "node scripts/bot-improvement/prepare-analyses.ts",
    "bot:session": "node scripts/bot-improvement/control-session.ts",
    "bot:setup": "node --experimental-vm-modules scripts/bot-improvement/setup-session.ts",
    "bot:validate": "node --experimental-vm-modules scripts/bot-improvement/validate-candidate.ts",
    "bot:prepare-iteration": "node scripts/bot-improvement/prepare-iteration.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "saxes": "^6.0.0",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "^2.12.0",
    "svelte": "^5.56.4"
  }
}
